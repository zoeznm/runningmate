div(class="skeleton-root", [ngSwitch]="type || 'list'", aria-hidden="true")
    div(*ngSwitchCase="'home'", class="skeleton-home")
        div(class="skeleton-block skeleton-hero")
        div(class="skeleton-grid")
            div(class="skeleton-block skeleton-stat", *ngFor="let row of statItems")
        div(class="skeleton-block skeleton-wide")
        div(class="skeleton-list")
            div(class="skeleton-row-card", *ngFor="let row of rowItems()")
                div(class="skeleton-circle")
                div(class="skeleton-row-lines")
                    span
                    span
    div(*ngSwitchCase="'chart'", class="skeleton-chart")
        div(class="skeleton-chart-head")
            div(class="skeleton-line")
            div(class="skeleton-pill")
        div(class="skeleton-bars")
            span(*ngFor="let height of chartHeights", [style.height.%]="height")
        div(class="skeleton-chart-footer")
            div(class="skeleton-line")
            div(class="skeleton-line")
    ng-template(ngSwitchDefault)
        div(class="skeleton-list")
            div(class="skeleton-row-card", *ngFor="let row of rowItems()")
                div(class="skeleton-circle")
                div(class="skeleton-row-lines")
                    span
                    span
                div(class="skeleton-pill")
