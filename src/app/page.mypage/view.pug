nav(class="sticky top-0 z-20 bg-white shadow")
    div(class="max-w-3xl px-2 sm:px-4 lg:px-8 py-3 lg:px-6")
        div(class="flex items-center justify-between")
            div(class="min-w-0 flex-1")
                h1(class="flex text-lg font-semibold text-zinc-950 gap-x-3 items-center")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-6")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z")
                    span 내 프로필

div(*ngIf="loading", class="max-w-3xl px-8 py-8")
    wiz-component-loading-skeleton(type="list", rows="4")

div(*ngIf="!loading && loadError", class="max-w-3xl px-8 py-8")
    wiz-component-error-state([message]="loadError", [onRetry]="retryLoad")

ng-container(*ngIf="!loading && !loadError && user")
    div(class="max-w-3xl pt-8 px-8 pb-12 space-y-8")
        //- Profile Section
        div(class="bg-white rounded-xl border border-gray-200 overflow-hidden")
            div(class="px-6 py-5 border-b border-gray-100")
                h2(class="text-[15px] font-semibold text-gray-900") 개인정보
                p(class="mt-1 text-[13px] text-gray-500") 기본 프로필 정보를 수정할 수 있습니다.

            div(class="px-6 py-6 space-y-5")
                //- Avatar
                div(class="flex items-center gap-x-4 pb-2")
                    div(class="flex items-center justify-center w-14 h-14 rounded-full bg-indigo-100 text-indigo-600 text-xl font-bold")
                        | {{user.name?.charAt(0) || '?'}}
                    div
                        p(class="text-[13px] font-medium text-gray-900") {{user.name}}
                        p(class="text-[13px] text-gray-500") {{user.email}}
                        span(class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium mt-1",
                            [ngClass]="user.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'")
                            | {{user.role}}

                //- Email (readonly)
                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-1") 이메일
                    input(type="email", [value]="user.email", disabled, class="block w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-[13px] text-gray-500")

                //- Name
                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-1") 이름
                    input(type="text", [(ngModel)]="user.name", class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none")

                //- Mobile
                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-1") 연락처
                    input(type="text", [(ngModel)]="user.mobile", placeholder="010-0000-0000", class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none")

                div(class="rounded-lg border border-gray-200 px-4 py-3")
                    div(class="flex items-center justify-between gap-4")
                        div
                            p(class="text-[13px] font-semibold text-gray-900") 공개 통계
                            p(class="mt-1 text-[12px] text-gray-500") 비공개로 전환하면 친구 화면에서 총거리와 이번달 거리 통계를 숨깁니다.
                        label(class="relative inline-flex cursor-pointer items-center")
                            input(type="checkbox", class="peer sr-only", [(ngModel)]="user.is_public")
                            span(class="h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-indigo-600 peer-checked:after:translate-x-5")

            div(class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end")
                button(
                    (click)="updateProfile()",
                    [disabled]="saving",
                    class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-[13px] font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-50")
                    wiz-component-loading-spinner(*ngIf="saving", size="sm", label="저장 중")
                    span {{saving ? '저장 중' : '저장'}}

        //- Password Section
        div(class="bg-white rounded-xl border border-gray-200 overflow-hidden")
            div(class="px-6 py-5 border-b border-gray-100")
                h2(class="text-[15px] font-semibold text-gray-900") 비밀번호 변경
                p(class="mt-1 text-[13px] text-gray-500") 보안을 위해 주기적으로 비밀번호를 변경해주세요.

            div(class="px-6 py-6 space-y-5")
                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-1") 현재 비밀번호
                    input(type="password", [(ngModel)]="passwordForm.current_password", placeholder="현재 비밀번호 입력", class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none")

                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-1") 새 비밀번호
                    input(type="password", [(ngModel)]="passwordForm.new_password", placeholder="8자 이상 입력", class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none")
                    p(class="mt-1 text-[12px]", [ngClass]="passwordMinLengthOk ? 'text-emerald-600' : 'text-gray-500'") 최소 8자, 영문+숫자 조합을 권장합니다.

                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-1") 새 비밀번호 확인
                    input(type="password", [(ngModel)]="passwordForm.confirm_password", placeholder="새 비밀번호 다시 입력", class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none")
                    p(class="mt-1 text-[12px]", [ngClass]="passwordMatches ? 'text-emerald-600' : passwordMatchTouched ? 'text-red-600' : 'text-gray-500'") {{passwordMatchText}}

                div(class="rounded-lg border border-gray-200 px-4 py-3")
                    div(class="flex items-center justify-between gap-4")
                        div
                            p(class="text-[13px] font-semibold text-gray-900") 다른 기기 세션 무효화
                            p(class="mt-1 text-[12px] text-gray-500") 변경 후 다른 기기는 다시 로그인하게 합니다.
                        label(class="relative inline-flex cursor-pointer items-center")
                            input(type="checkbox", class="peer sr-only", [(ngModel)]="passwordForm.invalidate_other_sessions")
                            span(class="h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-indigo-600 peer-checked:after:translate-x-5")

            div(class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end")
                button(
                    (click)="changePassword()",
                    [disabled]="!passwordCanSubmit || changingPassword",
                    class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-[13px] font-semibold text-white shadow-sm hover:bg-red-500 disabled:opacity-50")
                    wiz-component-loading-spinner(*ngIf="changingPassword", size="sm", label="비밀번호 변경 중")
                    span {{changingPassword ? '변경 중' : '비밀번호 변경'}}

        //- Agreement Section
        div(*ngIf="agreement", class="bg-white rounded-xl border border-gray-200 overflow-hidden")
            div(class="px-6 py-5 border-b border-gray-100")
                h2(class="text-[15px] font-semibold text-gray-900") 정보
                p(class="mt-1 text-[13px] text-gray-500") 약관과 개인정보처리방침을 확인하고 마케팅 수신 동의를 변경할 수 있습니다.

            div(class="px-6 py-6 space-y-4")
                div(class="grid gap-3 sm:grid-cols-2")
                    button(type="button", (click)="openPolicy('terms')", class="flex items-center justify-between rounded-lg border border-gray-200 px-4 py-3 text-left hover:border-indigo-200 hover:bg-indigo-50")
                        span
                            span(class="block text-[13px] font-semibold text-gray-900") 이용약관
                            span(class="mt-1 block text-[12px] text-gray-500") v{{policy('terms')?.version}} · {{policy('terms')?.effective_date}}
                        span(class="ml-3 text-[13px] font-semibold text-gray-400") >
                    button(type="button", (click)="openPolicy('privacy')", class="flex items-center justify-between rounded-lg border border-gray-200 px-4 py-3 text-left hover:border-indigo-200 hover:bg-indigo-50")
                        span
                            span(class="block text-[13px] font-semibold text-gray-900") 개인정보처리방침
                            span(class="mt-1 block text-[12px] text-gray-500") v{{policy('privacy')?.version}} · {{policy('privacy')?.effective_date}}
                        span(class="ml-3 text-[13px] font-semibold text-gray-400") >

                div(class="rounded-lg border border-gray-200 px-4 py-3")
                    div(class="flex items-center justify-between gap-4")
                        div
                            p(class="text-[13px] font-semibold text-gray-900") 마케팅 정보 수신 동의
                            p(class="mt-1 text-[12px] text-gray-500") 최근 동의: {{agreement.latest?.agreed_at ? (agreement.latest.agreed_at | date:'yyyy-MM-dd HH:mm') : '기록 없음'}}
                        label(class="relative inline-flex cursor-pointer items-center")
                            input(type="checkbox", class="peer sr-only", [(ngModel)]="agreement.latest.marketing_optin", (change)="updateMarketingAgreement()", [disabled]="agreementSaving")
                            span(class="h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:bg-indigo-600 peer-checked:after:translate-x-5 peer-disabled:opacity-50")

                div(class="rounded-lg bg-gray-50 px-4 py-3 text-[12px] leading-5 text-gray-500")
                    | 필수 약관 동의 버전: 이용약관 v{{agreement.latest?.terms_version || '-'}} · 개인정보처리방침 v{{agreement.latest?.privacy_version || '-'}}

        //- Account Delete Section
        div(class="overflow-hidden rounded-xl border border-red-200 bg-white dark:border-red-900/60 dark:bg-slate-950")
            div(class="border-b border-red-100 px-6 py-5 dark:border-red-900/50")
                h2(class="text-[15px] font-semibold text-red-700 dark:text-red-300") 계정
                p(class="mt-1 text-[13px] text-gray-500 dark:text-slate-400") 계정과 서비스 데이터를 삭제할 수 있습니다.

            div(class="px-6 py-6")
                div(class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between")
                    div
                        p(class="text-[13px] font-semibold text-gray-900 dark:text-white") 계정 삭제
                        p(class="mt-1 text-[12px] leading-5 text-gray-500 dark:text-slate-400") 계정, 소셜 로그인 연결, 러닝 기록, 사진/영상, 목표와 친구 관계가 삭제되거나 익명화됩니다.
                    button(
                        type="button",
                        (click)="openAccountDelete()",
                        [disabled]="deletingAccount",
                        class="inline-flex items-center justify-center rounded-lg border border-red-300 px-4 py-2 text-[13px] font-semibold text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-red-800 dark:text-red-300 dark:hover:bg-red-950/40")
                        | 계정 삭제

                div(*ngIf="deleteStep === 1", class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-4 dark:border-red-900/70 dark:bg-red-950/30")
                    p(class="text-[13px] font-bold text-red-800 dark:text-red-200") 삭제 전 반드시 확인해주세요
                    ul(class="mt-3 space-y-2 text-[13px] leading-5 text-red-700 dark:text-red-200")
                        li 계정 정보, 소셜 로그인 연결, 비밀번호 재설정 토큰과 약관 동의 이력이 삭제됩니다.
                        li 러닝 기록, 휴식일, 월간 목표, 체중 기록, 채팅 세션과 알림이 삭제됩니다.
                        li 업로드한 러닝 사진과 영상 파일이 스토리지에서 삭제됩니다.
                        li 챌린지 참여, 랭킹 프로필, 친구/팔로우 관계가 삭제되거나 탈퇴한 사용자로 익명화됩니다.
                        li(class="font-bold") 계정 삭제는 되돌릴 수 없습니다.
                    div(class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end")
                        button(type="button", (click)="closeAccountDelete()", class="rounded-lg border border-red-200 px-4 py-2 text-[13px] font-semibold text-red-700 hover:bg-white dark:border-red-800 dark:text-red-200 dark:hover:bg-slate-900") 취소
                        button(type="button", (click)="continueAccountDelete()", class="rounded-lg bg-red-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-red-500") 계속

                div(*ngIf="deleteStep === 2", class="mt-5 rounded-lg border border-gray-200 px-4 py-4 dark:border-slate-800")
                    label(class="block text-[13px] font-semibold text-gray-900 dark:text-white") 확인 문구
                    p(class="mt-1 text-[12px] leading-5 text-gray-500 dark:text-slate-400") 아래 입력창에 삭제를 정확히 입력해야 최종 삭제가 가능합니다.
                    input(
                        type="text",
                        [(ngModel)]="accountDeleteForm.confirm_text",
                        placeholder="삭제",
                        autocomplete="off",
                        class="mt-3 block w-full rounded-lg border border-gray-300 px-3 py-2 text-[13px] text-gray-900 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500 dark:border-slate-700 dark:bg-slate-900 dark:text-white")
                    div(class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end")
                        button(type="button", (click)="closeAccountDelete()", [disabled]="deletingAccount", class="rounded-lg border border-gray-200 px-4 py-2 text-[13px] font-semibold text-gray-600 hover:bg-gray-50 disabled:opacity-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900") 취소
                        button(type="button", (click)="deleteAccount()", [disabled]="!accountDeleteReady || deletingAccount", class="rounded-lg bg-red-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-red-500 disabled:cursor-not-allowed disabled:opacity-40")
                            span(class="inline-flex items-center gap-2")
                                wiz-component-loading-spinner(*ngIf="deletingAccount", size="sm", label="삭제 중")
                                span {{deletingAccount ? '삭제 중' : '최종 삭제'}}

div(*ngIf="accountDeleted", class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 py-6 text-slate-950 dark:text-white")
    section(class="w-full max-w-sm rounded-lg bg-white px-6 py-6 text-center shadow-2xl dark:bg-slate-900", role="dialog", aria-modal="true", aria-label="계정 삭제 완료")
        h2(class="text-base font-bold text-gray-950 dark:text-white") 계정 삭제 완료
        p(class="mt-2 text-[13px] leading-5 text-gray-500 dark:text-slate-300") 계정과 연결된 데이터 삭제가 완료되었습니다. 로그인 화면으로 이동합니다.

div(*ngIf="activePolicy", class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 py-6")
    div(class="absolute inset-0", (click)="closePolicy()")
    section(class="relative z-10 flex max-h-full w-full max-w-2xl flex-col rounded-lg bg-white shadow-2xl", role="dialog", aria-modal="true")
        div(class="flex items-start justify-between border-b border-gray-200 px-5 py-4")
            div
                h2(class="text-base font-bold text-gray-950") {{policy(activePolicy)?.title}}
                p(class="mt-1 text-[12px] text-gray-500") 버전 {{policy(activePolicy)?.version}} · 시행일 {{policy(activePolicy)?.effective_date}}
            button(type="button", (click)="closePolicy()", aria-label="닫기", class="rounded-lg px-2 py-1 text-xl leading-none text-gray-500 hover:bg-gray-100 hover:text-gray-900") ×
        div(class="overflow-y-auto px-5 py-4")
            div(*ngFor="let section of policy(activePolicy)?.sections", class="mb-5 last:mb-0")
                h3(class="text-[13px] font-semibold text-gray-900") {{section.title}}
                p(class="mt-2 whitespace-pre-line text-[13px] leading-6 text-gray-600") {{section.body}}
        div(class="border-t border-gray-200 px-5 py-4 text-right")
            button(type="button", (click)="closePolicy()", class="rounded-lg bg-indigo-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-indigo-500") 확인
