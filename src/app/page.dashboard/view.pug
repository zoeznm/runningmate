main(class="app-wrapper", [class.dark-screen]="isDark", [class.light-screen]="!isDark", [class.loading-screen-mode]="isInitialLoading", [class.live-run-screen-mode]="activeScreen === 'live-run'", [class.live-run-paused-mode]="activeScreen === 'live-run' && isLiveRunPaused", id="appRoot", aria-label="러닝메이트 디자인 레퍼런스")
    div([class]="phoneClass", [class.live-run-mode]="activeScreen === 'live-run'", [class.live-run-paused-mode]="activeScreen === 'live-run' && isLiveRunPaused")
        wiz-component-loading-fullscreen(*ngIf="isInitialLoading", message="RunMate", [detail]="initialLoadingDetail", [tips]="initialLoadingTips")
        div(*ngIf="!isInitialLoading && initialErrorMessage", class="dashboard-error-overlay")
            wiz-component-error-state([message]="initialErrorMessage", [onRetry]="retryInitialLoad")

        div(class="screen-page", [class.active]="activeScreen === 'home'", id="screen-home")
            div(class="home-content")
                div(class="greeting-row")
                    div
                        div(class="greeting-name") {{homeTitle}}
                        div(class="greeting-sub") {{goalMessage}}
                    div(class="avatar")
                        img(*ngIf="homeProfileImage", [src]="homeProfileImage", [attr.alt]="profileNameText")
                        span(*ngIf="!homeProfileImage") {{homeAvatarText}}

                button(
                    type="button",
                    class="home-live-run-button",
                    [class.active]="isLiveRunActive",
                    [class.paused]="isLiveRunPaused",
                    [disabled]="isLiveRunBusy || isLiveRunSaving",
                    (click)="openLiveRunScreen()")
                    span(class="home-live-run-icon")
                        i(class="fa-solid", [ngClass]="isLiveRunBusy ? 'fa-spinner' : isLiveRunActive ? 'fa-chart-line' : 'fa-play'", aria-hidden="true")
                    span(class="home-live-run-copy")
                        span(class="home-live-run-eyebrow") 실시간 러닝
                        strong {{homeLiveRunButtonText}}
                    span(class="home-live-run-arrow", aria-hidden="true")
                        i(class="fa-solid fa-chevron-right")

                div(class="month-total-card")
                    div(class="month-label") 이번달 총 거리
                    div(class="month-km")
                        | {{formattedTotalKm}}
                        span {{distanceUnitLabel}}

                div(class="stats-grid")
                    div(*ngFor="let stat of statCards; trackBy: trackByLabel", class="stat-card")
                        i(class="fa-solid stat-icon", [ngClass]="stat.icon", aria-hidden="true")
                        div(class="stat-label") {{stat.label}}
                        div(class="stat-value")
                            | {{stat.value}}
                            span(class="stat-unit") {{stat.unit}}

                div(class="stat-card wide-stat-card")
                    div
                        div(class="stat-label") 평균 거리
                        div(class="stat-value")
                            | {{formattedAvgKm}}
                            span(class="stat-unit") {{distanceUnitLabel}}
                    div(class="wide-stat-right")
                        div(class="stat-label") 소모 칼로리
                        div(class="stat-value")
                            | {{formattedCalories}}
                            span(class="stat-unit") kcal

                div(*ngIf="targetWeightKg !== null || currentWeightLog", class="home-weight-goal-card", [ngClass]="weightGoalTone")
                    div
                        div(class="stat-label") 목표 체중
                        div(class="stat-value")
                            | {{targetWeightKg !== null ? targetWeightText : '-'}}
                            span(class="stat-unit") kg
                        div(class="home-weight-current") 현재 {{currentWeightLog ? currentWeightText + 'kg' : '-'}}
                    div(class="home-weight-goal-side")
                        div(class="stat-label") 감량 필요
                        div(class="home-weight-goal-value") {{weightGoalRemainingText}}

        div(class="screen-page", [class.active]="activeScreen === 'live-run'", id="screen-live-run")
            div(class="live-run-page-content")
                section(*ngIf="!completedLiveRun", class="live-run-active-stage")
                    div(class="live-run-active-head")
                        button(
                            type="button",
                            class="live-run-cancel-action",
                            [disabled]="isLiveRunDiscarding",
                            aria-label="저장하지 않고 러닝 종료",
                            title="저장하지 않고 러닝 종료",
                            data-live-run-cancel="true",
                            (click)="requestDiscardLiveRun($event)")
                            i(class="fa-solid fa-xmark", aria-hidden="true")
                        div
                            div(class="live-run-active-label") 실시간 러닝
                            div(class="live-run-active-status") {{liveRunStatus}}
                        div(class="live-run-active-chip", [class.running]="liveRun.status === 'running'", [class.paused]="liveRun.status === 'paused'")
                            i(class="fa-solid", [ngClass]="liveRun.status === 'running' ? 'fa-satellite-dish' : liveRun.status === 'paused' ? 'fa-pause' : 'fa-location-arrow'", aria-hidden="true")
                            span {{liveRun.status === 'running' ? '측정 중' : liveRun.status === 'paused' ? '일시정지' : '대기'}}

                    div(class="live-run-big-distance")
                        span 거리
                        strong {{liveRunDistanceText}}

                    div(class="live-run-live-grid")
                        div(class="live-run-live-metric")
                            span 현재 페이스
                            strong {{liveRunCurrentPaceText}}
                        div(class="live-run-live-metric")
                            span 평균 페이스
                            strong {{liveRunPaceText}}
                        div(class="live-run-live-metric")
                            span 심박수
                            strong {{liveRunHeartRateText}}
                        div(class="live-run-live-metric")
                            span 시간
                            strong {{liveRunElapsedText}}
                        div(class="live-run-live-metric")
                            span 케이던스
                            strong {{liveRunCadenceText}}

                    div(class="live-run-bottom-actions")
                        button(
                            type="button",
                            class="live-run-pause-action",
                            [disabled]="isLiveRunBusy || isLiveRunSaving || !isLiveRunActive",
                            (click)="toggleLiveRunPause()")
                            i(class="fa-solid", [ngClass]="isLiveRunBusy ? 'fa-spinner' : isLiveRunPaused ? 'fa-play' : 'fa-pause'", aria-hidden="true")
                            span {{isLiveRunBusy ? '처리 중' : isLiveRunPaused ? '재개' : '일시정지'}}
                        button(
                            type="button",
                            class="live-run-save-action",
                            [disabled]="isLiveRunBusy || isLiveRunSaving || !isLiveRunActive",
                            (click)="finishLiveRun()")
                            i(class="fa-solid", [ngClass]="isLiveRunSaving ? 'fa-spinner' : 'fa-flag-checkered'", aria-hidden="true")
                            span {{isLiveRunSaving ? '저장 중' : '종료 저장'}}

                div(*ngIf="liveRunDiscardConfirmVisible && !completedLiveRun", class="live-run-discard-confirm-backdrop", role="dialog", aria-modal="true", aria-label="러닝 종료 확인", (click)="cancelLiveRunDiscard($event)")
                    section(class="live-run-discard-confirm", (click)="$event.stopPropagation()")
                        div(class="live-run-discard-confirm-icon")
                            i(class="fa-solid fa-stop", aria-hidden="true")
                        h3 저장하지 않고 러닝을 종료할까요?
                        p 현재 측정 기록은 저장되지 않습니다.
                        div(class="live-run-discard-confirm-actions")
                            button(type="button", class="live-run-discard-confirm-cancel", [disabled]="isLiveRunDiscarding", (click)="cancelLiveRunDiscard($event)") 취소
                            button(type="button", class="live-run-discard-confirm-accept", [disabled]="isLiveRunDiscarding", (click)="confirmLiveRunDiscard($event)")
                                span {{isLiveRunDiscarding ? '종료 중' : '저장 없이 종료'}}

                section(*ngIf="completedLiveRun", class="live-run-summary-stage")
                    div(class="live-run-summary-map")
                        button(type="button", class="live-run-summary-back", aria-label="기록 탭으로 돌아가기", title="기록 탭으로 돌아가기", (click)="closeLiveRunSummaryToCalendar()")
                            i(class="fa-solid fa-chevron-left", aria-hidden="true")
                        div(class="live-run-map-grid", aria-hidden="true")
                        svg(class="live-run-map-route", viewBox="0 0 100 100", preserveAspectRatio="none", aria-hidden="true")
                            polyline(class="live-run-route-line", [attr.points]="liveRunRoutePolyline")
                        div(class="live-run-map-pin live-run-map-pin-start")
                            i(class="fa-solid fa-circle", aria-hidden="true")
                            span 출발
                        div(class="live-run-map-pin live-run-map-pin-end")
                            i(class="fa-solid fa-location-dot", aria-hidden="true")
                            span 도착
                        div(class="live-run-map-caption")
                            strong {{completedLiveRunDateText}}
                            span {{completedLiveRunRouteText}}

                    div(class="live-run-summary-panel")
                        div(class="live-run-summary-title") 러닝 저장 완료
                        div(class="live-run-summary-grid")
                            div(class="live-run-summary-metric")
                                span 거리
                                strong {{completedLiveRunDistanceText}}
                            div(class="live-run-summary-metric")
                                span 평균 페이스
                                strong {{completedLiveRunPaceText}}
                            div(class="live-run-summary-metric")
                                span 심박수
                                strong {{completedLiveRunHeartRateText}}
                            div(class="live-run-summary-metric")
                                span 시간
                                strong {{completedLiveRunElapsedText}}
                            div(class="live-run-summary-metric")
                                span 케이던스
                                strong {{completedLiveRunCadenceText}}

        div(class="screen-page", [class.active]="activeScreen === 'goals'", id="screen-goals")
            div(class="goals-content")
                div(class="screen-heading goals-heading")
                    div
                        div(class="section-title heading-title") 목표 설정
                        div(class="stat-label heading-sub") {{goalMonthTitle}}
                    div(class="goals-month-chip") {{goalProgressCards.length}}개
                div(class="group-switcher", role="tablist", aria-label="목표 메뉴")
                    button(
                        *ngFor="let item of goalGroupItems; trackBy: trackById",
                        type="button",
                        class="group-switcher-btn",
                        role="tab",
                        [attr.data-screen]="item.id",
                        [class.active]="activeScreen === item.id",
                        [attr.aria-selected]="activeScreen === item.id",
                        (click)="setScreen(item.id)")
                        i(class="fa-solid", [ngClass]="item.icon", aria-hidden="true")
                        span {{item.label}}

                div(*ngIf="goalStatus", class="goal-status") {{goalStatus}}

                div(class="goal-setup-list")
                    section(
                        *ngFor="let option of goalTypeOptions; trackBy: trackGoalOption",
                        class="goal-setup-card",
                        [class.configured]="goalByType(option.id) !== null",
                        [class.achieved]="goalProgressByType(option.id)?.achieved")
                        div(class="goal-setup-head")
                            div(class="goal-setup-icon")
                                i(class="fa-solid", [ngClass]="option.icon", aria-hidden="true")
                            div(class="goal-setup-title-wrap")
                                div(class="goal-setup-title") {{goalOptionLabel(option.id)}}
                                div(class="goal-setup-sub") {{goalProgressByType(option.id)?.message || '미설정'}}
                            div(class="goal-setup-state")
                                i(*ngIf="goalProgressByType(option.id)?.achieved", class="fa-solid fa-check", aria-hidden="true")
                                span {{goalStatusText(option.id)}}
                        div(*ngIf="goalProgressByType(option.id)", class="goal-setup-progress")
                            div(class="home-goal-progress-track")
                                div(class="home-goal-progress-fill", [style.width.%]="goalProgressByType(option.id)?.percent || 0")
                            div(class="home-goal-progress-meta")
                                span {{goalProgressByType(option.id)?.current_text}}
                                span {{goalProgressByType(option.id)?.target_text}}
                        div(class="goal-input-row")
                            div(class="goal-input-wrap")
                                input(
                                    type="text",
                                    [attr.inputmode]="option.id === 'pace' ? 'text' : 'decimal'",
                                    [placeholder]="goalPlaceholder(option.id)",
                                    [(ngModel)]="goalDrafts[option.id]",
                                    [attr.aria-label]="option.label + ' 목표값'")
                                span {{goalOptionUnit(option.id)}}
                            button(type="button", class="goal-save-btn", [disabled]="isGoalSaving", (click)="saveGoal(option.id)")
                                i(class="fa-solid", [ngClass]="isGoalSaving ? 'fa-spinner' : 'fa-check'", aria-hidden="true")
                                span {{goalActionText(option.id)}}
                            button(
                                *ngIf="goalByType(option.id)",
                                type="button",
                                class="goal-delete-btn",
                                aria-label="목표 삭제",
                                title="목표 삭제",
                                [disabled]="deletingGoalType === option.id",
                                (click)="deleteGoal(option.id)")
                                i(class="fa-solid", [ngClass]="deletingGoalType === option.id ? 'fa-spinner' : 'fa-trash-can'", aria-hidden="true")

        div(class="screen-page", [class.active]="activeScreen === 'challenges'", id="screen-challenges")
            div(class="challenge-content")
                div(class="screen-heading challenge-heading")
                    div
                        div(class="section-title heading-title") 그룹 챌린지
                        div(class="stat-label heading-sub") {{challengeSummaryText}}
                    div(class="challenge-head-chip") {{challenges.length}}개
                div(class="group-switcher", role="tablist", aria-label="목표 메뉴")
                    button(
                        *ngFor="let item of goalGroupItems; trackBy: trackById",
                        type="button",
                        class="group-switcher-btn",
                        role="tab",
                        [attr.data-screen]="item.id",
                        [class.active]="activeScreen === item.id",
                        [attr.aria-selected]="activeScreen === item.id",
                        (click)="setScreen(item.id)")
                        i(class="fa-solid", [ngClass]="item.icon", aria-hidden="true")
                        span {{item.label}}

                div(*ngIf="challengeStatus", class="goal-status challenge-status") {{challengeStatus}}

                div(*ngIf="challengeViewMode === 'list'", class="challenge-list-page")
                    div(class="challenge-tab-row", role="tablist", aria-label="챌린지 목록")
                        button(
                            *ngFor="let tab of challengeTabOptions; trackBy: trackChallengeTab",
                            type="button",
                            class="challenge-tab-btn",
                            [class.active]="activeChallengeTab === tab.id",
                            [attr.aria-selected]="activeChallengeTab === tab.id",
                            (click)="setChallengeTab(tab.id)") {{tab.label}}

                    div(*ngIf="activeChallengeTab === 'owned'", class="challenge-action-row")
                        button(type="button", class="challenge-create-nav", (click)="openChallengeCreate()")
                            i(class="fa-solid fa-plus", aria-hidden="true")
                            span 챌린지 생성하기

                    div(*ngIf="isChallengeLoading && !challenges.length", class="challenge-empty")
                        wiz-component-loading-skeleton(type="list", rows="3")

                    section(*ngIf="!isChallengeLoading && !activeChallengeList.length", class="empty-state empty-state-panel challenge-empty")
                        i(class="fa-solid fa-flag-checkered empty-state-icon", aria-hidden="true")
                        div(class="empty-state-title") 표시할 챌린지가 없어

                    div(*ngIf="activeChallengeList.length", class="challenge-list", role="list")
                        section(
                            *ngFor="let challenge of activeChallengeList; trackBy: trackChallenge",
                            class="challenge-list-card",
                            [class.ended]="challenge.status === 'ended'",
                            role="listitem",
                            tabindex="0",
                            (click)="selectChallenge(challenge)",
                            (keydown.enter)="selectChallenge(challenge)",
                            (keydown.space)="selectChallenge(challenge)")
                            div(class="challenge-card-top")
                                div(class="challenge-card-main")
                                    div(class="challenge-title") {{challenge.title}}
                                    div(class="challenge-meta")
                                        span {{challenge.type_label}}
                                        span {{challenge.member_count}}명
                                        span {{challenge.d_day}}
                                div(class="challenge-status-pill", [ngClass]="challengeStatusClass(challenge)") {{challenge.status_label}}
                            div(class="challenge-progress-track")
                                div(class="challenge-progress-fill", [style.width.%]="challenge.progress_percent")
                            div(class="challenge-card-bottom")
                                span {{challenge.current_text}} / {{challenge.target_text}}
                                span {{challenge.progress_percent}}%
                            div(*ngIf="(!challenge.viewer_joined && challenge.status !== 'ended') || challenge.viewer_owned", class="challenge-card-actions")
                                button(
                                    *ngIf="!challenge.viewer_joined && challenge.status !== 'ended'",
                                    type="button",
                                    class="challenge-join-inline",
                                    [disabled]="isChallengeJoining",
                                    (click)="joinRecruitingChallenge(challenge, $event)")
                                    i(class="fa-solid fa-user-plus", aria-hidden="true")
                                    span 참여
                                button(
                                    *ngIf="challenge.viewer_owned",
                                    type="button",
                                    class="challenge-delete-inline",
                                    [disabled]="deletingChallengeId === challenge.id",
                                    aria-label="챌린지 삭제",
                                    title="챌린지 삭제",
                                    (click)="deleteChallenge(challenge, $event)")
                                    i(class="fa-solid", [ngClass]="deletingChallengeId === challenge.id ? 'fa-spinner' : 'fa-trash-can'", aria-hidden="true")
                                    span 삭제

                div(*ngIf="challengeViewMode === 'detail'", class="challenge-detail-page")
                    section(*ngIf="selectedChallenge as challenge", class="challenge-detail-card", [ngClass]="challenge.result_status")
                        div(class="challenge-detail-toolbar")
                            button(type="button", class="challenge-back-btn", aria-label="목록으로", title="목록으로", (click)="backToChallengeList()")
                                i(class="fa-solid fa-chevron-left", aria-hidden="true")
                                span 목록
                            button(
                                *ngIf="challenge.viewer_owned",
                                type="button",
                                class="challenge-delete-inline",
                                [disabled]="deletingChallengeId === challenge.id",
                                aria-label="챌린지 삭제",
                                title="챌린지 삭제",
                                (click)="deleteChallenge(challenge, $event)")
                                i(class="fa-solid", [ngClass]="deletingChallengeId === challenge.id ? 'fa-spinner' : 'fa-trash-can'", aria-hidden="true")
                                span 삭제
                        div(class="challenge-detail-head")
                            div
                                div(class="challenge-detail-label") {{challenge.status_label}} · {{challenge.period_text}}
                                div(class="challenge-detail-title") {{challenge.title}}
                            div(class="challenge-dday") {{challenge.d_day}}
                        div(class="challenge-detail-stat-grid")
                            div(class="challenge-detail-stat")
                                span D-Day
                                strong {{challenge.d_day}}
                            div(class="challenge-detail-stat")
                                span 진행도
                                strong {{challenge.progress_percent}}%
                            div(class="challenge-detail-stat")
                                span 참가자
                                strong {{challenge.member_count}}명
                        div(class="challenge-detail-progress")
                            div(class="challenge-detail-meter")
                                div(class="challenge-progress-fill", [style.width.%]="challenge.progress_percent")
                            div(class="challenge-detail-progress-meta")
                                span {{challenge.current_text}}
                                strong {{challenge.progress_percent}}%
                                span {{challenge.target_text}}
                        div(class="challenge-result-row", [ngClass]="challenge.result_status")
                            i(class="fa-solid", [ngClass]="challenge.result_status === 'achieved' ? 'fa-circle-check' : challenge.result_status === 'missed' ? 'fa-circle-xmark' : 'fa-hourglass-half'", aria-hidden="true")
                            div
                                div(class="challenge-result-title") {{challenge.result_text}}
                                div(class="challenge-result-sub") 초대코드 {{challenge.invite_code || '-'}}
                        div(class="challenge-rank-list")
                            div(class="challenge-rank-title") 참가자별 기여도
                            div(*ngFor="let member of challenge.members; trackBy: trackChallengeMember", class="challenge-rank-row")
                                div(class="challenge-rank-main")
                                    div(class="challenge-rank-badge") {{member.rank || '-'}}
                                    div(class="challenge-rank-name") {{member.user_name}}
                                div(class="challenge-rank-value") {{member.contributed_text || challengeValueText(challenge.type, member.contributed_value)}}
                                div(class="challenge-rank-track")
                                    div(class="challenge-rank-fill", [style.width.%]="member.progress_percent || 0")

                div(*ngIf="challengeViewMode === 'create'", class="challenge-create-page")
                    div(class="challenge-detail-toolbar challenge-create-toolbar")
                        button(type="button", class="challenge-back-btn", aria-label="목록으로", title="목록으로", (click)="backToChallengeList()")
                            i(class="fa-solid fa-chevron-left", aria-hidden="true")
                            span 목록
                    form(class="challenge-form-card", (submit)="saveChallenge(); $event.preventDefault()")
                        div(class="challenge-form-title")
                            i(class="fa-solid fa-plus", aria-hidden="true")
                            span 챌린지 생성
                        label(class="challenge-field challenge-field-full")
                            span 제목
                            input(
                                type="text",
                                name="challengeTitle",
                                maxlength="100",
                                placeholder="다같이 500km",
                                [(ngModel)]="challengeForm.title")
                        div(class="challenge-form-grid")
                            label(class="challenge-field")
                                span 종류
                                select(name="challengeType", [(ngModel)]="challengeForm.type")
                                    option(*ngFor="let option of challengeTypeOptions; trackBy: trackChallengeType", [ngValue]="option.id") {{option.label}}
                            label(class="challenge-field")
                                span 목표값
                                div(class="challenge-input-wrap")
                                    input(
                                        type="number",
                                        name="challengeGoalValue",
                                        inputmode="decimal",
                                        min="1",
                                        step="0.1",
                                        [placeholder]="challengeGoalPlaceholder",
                                        [(ngModel)]="challengeForm.goal_value")
                                    em {{challengeGoalUnit}}
                            label(class="challenge-field")
                                span 시작일
                                input(type="date", name="challengeStartDate", [(ngModel)]="challengeForm.start_date")
                            label(class="challenge-field")
                                span 종료일
                                input(type="date", name="challengeEndDate", [min]="challengeForm.start_date", [(ngModel)]="challengeForm.end_date")
                        button(type="submit", class="challenge-primary-btn", [disabled]="isChallengeSaving")
                            i(class="fa-solid", [ngClass]="isChallengeSaving ? 'fa-spinner' : 'fa-flag-checkered'", aria-hidden="true")
                            span {{challengeCreateButtonText}}

                    form(class="challenge-join-card", (submit)="joinChallengeByCode(); $event.preventDefault()")
                        div(class="challenge-form-title")
                            i(class="fa-solid fa-ticket", aria-hidden="true")
                            span 초대코드 참여
                        div(class="challenge-join-row")
                            input(
                                type="text",
                                name="challengeInviteCode",
                                maxlength="10",
                                placeholder="초대코드",
                                [(ngModel)]="challengeInviteCode")
                            button(type="submit", class="challenge-secondary-btn", [disabled]="isChallengeJoining")
                                i(class="fa-solid", [ngClass]="isChallengeJoining ? 'fa-spinner' : 'fa-user-plus'", aria-hidden="true")
                                span {{challengeJoinButtonText}}

        div(class="screen-page", [class.active]="activeScreen === 'feed'", id="screen-feed")
            div(class="friend-content feed-content")
                div(class="screen-heading friend-heading")
                    div
                        div(class="section-title heading-title") 피드
                        div(class="stat-label heading-sub") {{feedSummaryText}}
                    button(type="button", class="feed-refresh-btn", [disabled]="isFeedLoading", aria-label="피드 새로고침", title="새로고침", (click)="refreshFeed()")
                        i(class="fa-solid", [ngClass]="isFeedLoading ? 'fa-spinner' : 'fa-rotate-right'", aria-hidden="true")
                div(class="group-switcher", role="tablist", aria-label="커뮤니티 메뉴")
                    button(
                        *ngFor="let item of communityGroupItems; trackBy: trackById",
                        type="button",
                        class="group-switcher-btn",
                        role="tab",
                        [attr.data-screen]="item.id",
