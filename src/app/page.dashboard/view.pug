                        [(ngModel)]="feedCommentDrafts[activeProfileFeedRun.id]",
                        [disabled]="isFeedCommentBusy(activeProfileFeedRun)")
                    button(type="submit", [disabled]="isFeedCommentBusy(activeProfileFeedRun) || !feedCommentDraft(activeProfileFeedRun).trim()")
                        i(class="fa-solid", [ngClass]="isFeedCommentBusy(activeProfileFeedRun) ? 'fa-spinner' : 'fa-paper-plane'", aria-hidden="true")
                        span 등록

        div(*ngIf="activeJournalViewer", class="journal-viewer-backdrop", role="dialog", aria-modal="true", aria-label="러닝 일기 보기", (click)="closeJournalViewer()")
            div(class="journal-viewer-panel", (click)="$event.stopPropagation()")
                div(class="journal-viewer-head")
                    div
                        div(class="journal-viewer-label") 오늘의 일기
                        div(class="journal-viewer-title") {{displayDate(activeJournalViewer.date, true)}} · {{distanceText(activeJournalViewer.distance_km)}}
                    button(type="button", class="journal-viewer-close", aria-label="닫기", title="닫기", (click)="closeJournalViewer()")
                        i(class="fa-solid fa-xmark", aria-hidden="true")
                div(class="journal-viewer-stats")
                    div(*ngFor="let stat of activeJournalStats; trackBy: trackByLabel", class="journal-viewer-stat")
                        div(class="mini-stat-lbl") {{stat.label}}
                        div(class="mini-stat-val") {{stat.value}}
                div(class="journal-viewer-text") {{activeJournalViewer.journal}}

        nav(class="nav-bar", aria-label="하단 메뉴")
            button(
                *ngFor="let item of navItems; trackBy: trackById",
                type="button",
                class="nav-item",
                [attr.data-screen]="item.id",
                [class.active]="navIsActive(item.id)",
                [attr.aria-current]="navIsActive(item.id) ? 'page' : null",
                [attr.aria-label]="item.label + ' 화면으로 이동'",
                (click)="setScreen(item.id)")
                i(class="fa-solid", [ngClass]="item.icon", aria-hidden="true")
                span {{item.label}}
