                            div(class="friend-stat-value") {{distanceText(user.stats.total_distance_km)}}
                        div(class="friend-stat")
                            div(class="friend-stat-label") 총 횟수
                            div(class="friend-stat-value") {{user.stats.run_count}}회
                        div(class="friend-stat")
                            div(class="friend-stat-label") 이번달 거리
                            div(class="friend-stat-value") {{distanceText(user.stats.this_month_distance_km)}}
                        div(class="friend-stat")
                            div(class="friend-stat-label") 이번달 횟수
