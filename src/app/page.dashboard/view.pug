                        *ngFor="let item of goalGroupItems; trackBy: trackById",
                        type="button",
                        class="group-switcher-btn",
                        role="tab",
                        [attr.data-screen]="item.id",
                        [class.active]="activeScreen === item.id",
                        [attr.aria-selected]="activeScreen === item.id",
                        (click)="setScreen(item.id)")
                        i(class="fa-solid", [ngClass]="item.icon", aria-hidden="true")
                        span {{item.label}}

                section(class="achievement-summary-card")
                    div(class="achievement-summary-main")
                        div(class="achievement-summary-label") 획득 뱃지
                        div(class="achievement-summary-value")
                            | {{earnedBadgeCount}}
                            span / {{totalBadgeCount || 30}}
                    div(class="achievement-progress-track")
                        div(class="achievement-progress-fill", [style.width.%]="badgeAchievementRate")

