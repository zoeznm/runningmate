                    div(class="ranking-me-main")
                        div(class="ranking-me-label") {{rankingFinalized ? '마감 순위' : '내 순위'}}
                        div(class="ranking-me-title") {{rankingMyTitle}}
                        div(class="ranking-me-sub") {{rankingMeSubText}}
                    div(class="ranking-me-distance")
                        | {{rankingMyDistanceText}}
                        span {{distanceUnitLabel}}

