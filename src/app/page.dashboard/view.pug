                        div(class="friend-code-value", [class.loading]="isFriendCodeLoading") {{friendCodeText}}
                    div(class="friend-code-actions")
                        button(type="button", class="friend-code-action", [disabled]="!friendCode && isFriendCodeLoading", (click)="copyFriendCode()")
                            i(class="fa-solid fa-copy", aria-hidden="true")
                            span 코드 복사
                        button(type="button", class="friend-code-action", [disabled]="!friendCode && isFriendCodeLoading", (click)="shareFriendCode()")
                            i(class="fa-solid fa-share-nodes", aria-hidden="true")
                            span 공유하기
                    form(class="friend-code-form", (submit)="addFriendByCode(); $event.preventDefault()")
                        input(
                            type="text",
                            name="friendCode",
                            maxlength="32",
                            placeholder="친구코드 입력",
                            [(ngModel)]="friendCodeInput")
                        button(type="submit", class="friend-primary-btn", [disabled]="!friendCodeCanSubmit")
                            i(class="fa-solid", [ngClass]="isFriendCodeAdding ? 'fa-spinner' : 'fa-user-plus'", aria-hidden="true")
                            span {{isFriendCodeAdding ? '추가 중' : '추가'}}
                    div(*ngIf="friendCodeStatus", class="friend-code-status") {{friendCodeStatus}}

                form(class="friend-search-card compact", (submit)="searchFriends(); $event.preventDefault()")
                    div(class="friend-search-row")
                        input(
                            type="search",
                            name="friendSearch",
                            maxlength="80",
                            placeholder="친구 검색",
                            [(ngModel)]="friendSearchQuery")
                        button(type="submit", class="friend-primary-btn", [disabled]="isFriendSearchLoading")
                            i(class="fa-solid", [ngClass]="isFriendSearchLoading ? 'fa-spinner' : 'fa-magnifying-glass'", aria-hidden="true")
                            span 검색
                        button(
                            *ngIf="friendSearchQuery || friendSearchResults.length",
                            type="button",
                            class="friend-icon-btn",
                            aria-label="검색 초기화",
                            title="검색 초기화",
                            (click)="clearFriendSearch()")
                            i(class="fa-solid fa-xmark", aria-hidden="true")

                div(*ngIf="friendStatus", class="friend-status") {{friendStatus}}

                section(*ngIf="friendSearchResults.length", class="friend-panel")
                    div(class="friend-panel-head")
                        div
                            div(class="friend-panel-title") 검색 결과
                            div(class="friend-panel-sub") {{friendSearchResults.length}}명
                    div(class="friend-list", role="list")
                        article(
                            *ngFor="let user of friendSearchResults; trackBy: trackSocialProfile",
                            class="friend-row",
                            [class.active]="selectedFriendProfile?.id === user.id",
                            role="listitem",
                            tabindex="0",
                            (click)="selectFriendProfile(user)",
                            (keyup.enter)="selectFriendProfile(user)")
                            div(class="friend-avatar")
                                img(*ngIf="user.profile_image", [src]="user.profile_image", [attr.alt]="user.name")
                                span(*ngIf="!user.profile_image") {{avatarText(user.name)}}
                            div(class="friend-main")
                                div(class="friend-name")
                                    span {{user.name}}
                                    em(*ngIf="user.is_mutual") 상호
                                    em(*ngIf="!user.is_public") 비공개
                                div(class="friend-id") {{user.display_id}}
                            button(
                                *ngIf="!user.is_me",
                                type="button",
                                class="friend-follow-btn",
                                [class.following]="user.is_following",
                                [disabled]="followBusyUserId === user.id",
                                (click)="toggleFollow(user, $event)") {{followButtonText(user)}}

                section(class="friend-panel")
                    div(class="friend-panel-head")
                        div
