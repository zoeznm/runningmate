                            role="listitem",
                            tabindex="0",
                            (click)="selectFriendProfile(user)",
                            (keyup.enter)="selectFriendProfile(user)")
                            div(class="friend-avatar")
                                img(*ngIf="user.profile_image", [src]="user.profile_image", [attr.alt]="user.name")
                                span(*ngIf="!user.profile_image") {{avatarText(user.name)}}
                            div(class="friend-main")
                                div(class="friend-name")
                                    span {{user.name}}
                                    em(*ngIf="user.is_mutual") 상호
                                    em(*ngIf="!user.is_public") 비공개
                                div(class="friend-id") {{user.display_id}}
                            button(
                                *ngIf="!user.is_me",
                                type="button",
                                class="friend-follow-btn",
                                [class.following]="user.is_following",
                                [disabled]="followBusyUserId === user.id",
                                (click)="toggleFollow(user, $event)") {{followButtonText(user)}}

                section(*ngIf="selectedFriendProfile as user", class="friend-profile-card")
                    div(class="friend-profile-head")
                        div(class="friend-profile-avatar")
                            img(*ngIf="user.profile_image", [src]="user.profile_image", [attr.alt]="user.name")
                            span(*ngIf="!user.profile_image") {{selectedFriendInitial}}
                        div(class="friend-profile-main")
                            div(class="friend-profile-name") {{user.name}}
                            div(class="friend-profile-id") {{user.display_id}}
                            div(class="friend-profile-meta")
                                span 피드 {{friendFeedCount(user)}}
                                span 팔로워 {{user.follower_count}}
                                span 팔로잉 {{user.following_count}}
                        button(
                            *ngIf="!user.is_me",
                            type="button",
                            class="friend-profile-follow",
                            [class.following]="user.is_following",
                            [disabled]="followBusyUserId === user.id",
                            (click)="toggleFollow(user, $event)") {{followButtonText(user)}}

                    section(class="friend-badge-panel")
