                        class="period-btn ranking-scope-btn",
                        role="tab",
                        [class.active]="activeRankingScope === option.id",
                        [attr.aria-selected]="activeRankingScope === option.id",
                        (click)="setRankingScope(option.id)") {{option.label}}
                div(class="ranking-scope-note") {{rankingScopeDescription}}

