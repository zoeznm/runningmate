                        div(class="badge-icon-wrap")
                            i(class="fa-solid badge-icon", [ngClass]="badgeIconClass(badge)", aria-hidden="true")
                            i(*ngIf="!badge.achieved", class="fa-solid fa-lock badge-lock", aria-hidden="true")
                        div(class="badge-title") {{badge.title}}
                        div(class="badge-progress") {{badge.progress?.label || ''}}

                div(*ngIf="selectedBadge", class="badge-detail-panel")
