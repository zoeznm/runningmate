                        span {{item.label}}

                div(class="legend-row")
                    div(class="legend-item")
                        div(class="legend-dot dot-green")
                        | 러닝
                    div(class="legend-item")
                        div(class="legend-dot dot-strength")
                        | 근력
                    div(class="legend-item")
                        div(class="legend-dot dot-home-training")
                        | 홈트
                    div(class="legend-item")
                        div(class="legend-dot dot-gray")
