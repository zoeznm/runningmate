                        i(class="fa-solid", [ngClass]="rankingParticipationEnabled ? 'fa-eye' : 'fa-eye-slash'", aria-hidden="true")
                        span {{rankingParticipationStatusText}}
                div(class="group-switcher", role="tablist", aria-label="커뮤니티 메뉴")
                    button(
