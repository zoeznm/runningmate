                                span(*ngIf="!run.user.profile_image") {{avatarText(run.user.name)}}
                            div(class="feed-user-main")
                                div(class="friend-name")
                                    span {{run.user.name}}
                                div(class="friend-id") {{run.user.display_id}} · {{feedTimeText(run.created_at || run.date)}}
                            div(class="feed-privacy-chip") {{runPrivacyText(run)}}
                        div(class="feed-run-stats")
                            div(class="feed-run-stat")
                                strong {{formatDistance(run.distance_km)}}
                                span {{distanceUnitLabel}}
                            div(class="feed-run-stat")
                                strong {{displayPace(run.avg_pace)}}
                                span {{paceUnitLabel}}
                            div(class="feed-run-stat")
                                strong {{shortDuration(run)}}
                                span 시간
                        div(*ngIf="run.image_url", class="feed-route-image")
                            img([src]="run.image_url", [attr.alt]="feedRouteAltText(run)")
                        div(*ngIf="feedMediaItems(run).length", class="feed-media-grid", [class.single]="feedMediaItems(run).length === 1")
                            div(*ngFor="let media of feedMediaItems(run); trackBy: trackRunMedia", class="feed-media-item")
                                img(*ngIf="media.media_type === 'photo'", [src]="media.media_url", [attr.alt]="mediaAltText(media)")
                                video(*ngIf="media.media_type === 'video'", [src]="media.media_url", muted=true, playsinline=true, preload="metadata", controls=true)
                                span(class="feed-media-chip") {{mediaTypeLabel(media.media_type)}}
                        div(class="feed-action-row", role="group", aria-label="응원 반응")
                            button(
                                *ngFor="let reaction of run.reaction_summary; trackBy: trackFeedReaction",
                                type="button",
                                class="feed-reaction-btn",
                                [class.active]="reaction.reacted",
                                [disabled]="isFeedReactionBusy(run, reaction.type)",
                                [attr.aria-pressed]="reaction.reacted",
                                [attr.aria-label]="reaction.label",
                                (click)="toggleFeedReaction(run, reaction.type)")
                                span(class="feed-reaction-emoji") {{reaction.emoji}}
                                span(class="feed-reaction-count") {{reaction.count || ''}}
                        div(class="feed-count-row")
                            button(type="button", class="feed-count-btn", [disabled]="!run.reaction_count", (click)="toggleReactionUsers(run.id)")
                                i(class="fa-solid fa-heart", aria-hidden="true")
                                span 응원 {{run.reaction_count}}
                            button(type="button", class="feed-count-btn", [disabled]="!run.comment_count", (click)="toggleFeedComments(run.id)")
                                i(class="fa-solid fa-comment", aria-hidden="true")
                                span 댓글 {{run.comment_count}}
                        div(*ngIf="expandedReactionRunId === run.id", class="feed-reaction-panel")
                            div(*ngIf="!feedReactionUsers(run).length", class="feed-panel-empty") 아직 반응이 없어
                            div(*ngFor="let user of feedReactionUsers(run); trackBy: trackFeedReactionUser", class="feed-reaction-user")
                                span(class="feed-reaction-dot") {{user.type === 'like' ? '👍' : user.type === 'fire' ? '🔥' : user.type === 'clap' ? '👏' : '💪'}}
                                span {{user.name}}
                        div(*ngIf="run.comments.length", class="feed-comments")
                            div(*ngFor="let comment of visibleFeedComments(run); trackBy: trackFeedComment", class="feed-comment")
                                div(class="feed-comment-main")
                                    strong {{comment.user_name}}
                                    span {{comment.content}}
                                button(
                                    *ngIf="comment.is_mine",
                                    type="button",
                                    class="feed-comment-delete",
                                    [disabled]="deletingFeedCommentId === comment.id",
                                    aria-label="댓글 삭제",
                                    title="삭제",
                                    (click)="deleteFeedComment(run, comment, $event)")
                                    i(class="fa-solid fa-xmark", aria-hidden="true")
                            button(*ngIf="run.comments.length > 2", type="button", class="feed-comments-more", (click)="toggleFeedComments(run.id)")
                                | {{expandedCommentsRunId === run.id ? '댓글 접기' : '댓글 모두 보기'}}
                        form(class="feed-comment-form", (submit)="submitFeedComment(run); $event.preventDefault()")
                            input(
                                type="text",
                                maxlength="300",
                                [name]="'feedComment' + run.id",
                                placeholder="짧은 응원 댓글",
                                [(ngModel)]="feedCommentDrafts[run.id]",
                                [disabled]="isFeedCommentBusy(run)")
                            button(type="submit", [disabled]="isFeedCommentBusy(run) || !feedCommentDraft(run).trim()")
                                i(class="fa-solid", [ngClass]="isFeedCommentBusy(run) ? 'fa-spinner' : 'fa-paper-plane'", aria-hidden="true")
                                span 등록

        div(class="screen-page", [class.active]="activeScreen === 'friends'", id="screen-friends")
            div(class="friend-content")
                div(class="screen-heading friend-heading")
