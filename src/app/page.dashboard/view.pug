                            div(class="community-notice-sub") {{communityNotificationSummaryText}}
                        button(type="button", class="community-notice-read", [disabled]="!communityUnreadCount", aria-label="알림 읽음 처리", title="읽음", (click)="markCommunityNotificationsRead()")
                            i(class="fa-solid fa-check", aria-hidden="true")
                    div(
