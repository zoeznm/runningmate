                    div(class="community-notice-head")
                        div
                            div(class="community-notice-title") 알림
                            div(class="community-notice-sub") {{communityNotificationSummaryText}}
                        button(type="button", class="community-notice-read", [disabled]="!communityUnreadCount", aria-label="알림 읽음 처리", title="읽음", (click)="markCommunityNotificationsRead()")
                            i(class="fa-solid fa-check", aria-hidden="true")
                    div(
                        *ngFor="let item of communityNotifications; trackBy: trackCommunityNotification",
                        class="community-notice-row",
                        [class.unread]="!item.read_at")
                        i(class="fa-solid", [ngClass]="communityNotificationIcon(item)", aria-hidden="true")
                        div(class="community-notice-main")
                            div(class="community-notice-message") {{item.message}}
                            div(class="community-notice-time") {{communityNotificationTimeText(item)}}

                div(class="period-toggle ranking-scope-toggle", role="tablist", aria-label="랭킹 범위")
