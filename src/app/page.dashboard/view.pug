                        [ngClass]="entry.medal",
                        [attr.role]="isRankingEntryBlurred(entry, rankingIndex) ? 'listitem' : 'button'",
                        [attr.tabindex]="isRankingEntryBlurred(entry, rankingIndex) ? -1 : 0",
                        [attr.aria-disabled]="isRankingEntryBlurred(entry, rankingIndex) ? true : null",
                        [attr.aria-label]="rankingEntryProfileLabel(entry, rankingIndex)",
                        [attr.title]="rankingEntryProfileLabel(entry, rankingIndex)",
                        (click)="openRankingProfile(entry, $event, rankingIndex)",
                        (keydown.enter)="openRankingProfile(entry, $event, rankingIndex)",
                        (keydown.space)="openRankingProfile(entry, $event, rankingIndex)")
                        div(class="ranking-row-top")
                            div([class]="rankingRankClass(entry)")
                                i(*ngIf="entry.medal", class="fa-solid fa-medal", aria-hidden="true")
                                span(*ngIf="!entry.medal") {{rankingRankText(entry)}}
                            div(class="ranking-avatar")
                                img(*ngIf="entry.profile_image", [src]="entry.profile_image", [attr.alt]="entry.name")
