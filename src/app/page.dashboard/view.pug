                        div(class="empty-state-description") 검색으로 러너를 찾아 팔로우해봐

                    div(*ngIf="activeFriendList.length", class="friend-list", role="list")
                        article(
                            *ngFor="let user of activeFriendList; trackBy: trackSocialProfile",
                            class="friend-row",
