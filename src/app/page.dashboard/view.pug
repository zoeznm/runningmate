                            div(class="friend-stat-label") {{bestPaceMetricLabel}}
                            div(class="friend-stat-value") {{paceText(user.stats.best_pace)}}
                    div(*ngIf="user.stats_public && user.stats", class="friend-latest-run") 최근 러닝 {{user.stats.latest_run_date_text}}
                    section(*ngIf="!user.stats_public", class="friend-private-state")
                        i(class="fa-solid fa-lock", aria-hidden="true")
                        div
                            div(class="friend-private-title") 비공개 계정
                            div(class="friend-private-sub") 이 사용자는 공개 통계를 숨겼어

        div(class="screen-page", [class.active]="activeScreen === 'ranking'", id="screen-ranking")
