                div(*ngIf="isRankingLoading && !rankingEntries.length", class="ranking-empty")
                    wiz-component-loading-skeleton(type="list", rows="4")

                section(*ngIf="!isRankingLoading && !rankingEntries.length", class="empty-state empty-state-panel ranking-empty")
                    i(class="fa-solid fa-ranking-star empty-state-icon", aria-hidden="true")
                    div(class="empty-state-title") 표시할 랭킹이 없어
                    div(class="empty-state-description") {{rankingEmptyDescription}}

                div(*ngIf="rankingEntries.length", class="ranking-list", role="list")
                    article(
                        *ngFor="let entry of displayedRankingEntries; let rankingIndex = index; trackBy: trackRankingEntry",
