                        div(class="empty-state-description") 최소 2번은 뛰어야 해

                div(*ngIf="!isInitialLoading && hasEnoughAnalysisData", class="chart-scroll")
                    div(*ngFor="let chart of chartCards; trackBy: trackChart", class="chart-card")
                        div(class="chart-card-title") {{chart.title}}
                        div(*ngIf="chart.bars.length", class="bar-chart")
                            div(*ngFor="let bar of chart.bars", class="bar-col")
                                div(class="bar", [class.highlight]="bar.highlight", [class.short]="bar.height < 28", [style.height.%]="bar.height", [attr.title]="bar.valueText")
                                    span(class="bar-value") {{bar.valueText}}
                                div(class="bar-label") {{bar.label}}
                        div(*ngIf="!chart.bars.length", class="empty-state chart-empty") 기록 없음
                        div(class="chart-footer stat-label")
                            span {{chart.footerLeft}}
                            span(class="positive-text") {{chart.footerRight}}

                    div(class="chart-card goal-history-card")
                        div(class="chart-card-title") 월별 목표 달성
                        div(*ngIf="goalHistory.length", class="goal-history-list")
                            div(*ngFor="let month of goalHistory; trackBy: trackGoalHistory", class="goal-history-row", [class.achieved]="month.achieved")
                                div(class="goal-history-month")
                                    i(class="fa-solid", [ngClass]="month.achieved ? 'fa-check' : 'fa-xmark'", aria-hidden="true")
                                    span {{month.label}}
                                div(class="goal-history-items")
                                    span(*ngIf="!month.goal_count", class="goal-history-empty-chip") 목표 없음
                                    span(*ngFor="let goal of month.items; trackBy: trackGoalProgress", class="goal-history-chip", [class.achieved]="goal.achieved")
                                        | {{goal.label}} {{goal.achieved ? '✓' : '✗'}}
                                div(class="goal-history-score") {{month.achieved_count}}/{{month.goal_count}}
                        div(*ngIf="!goalHistory.length", class="empty-state chart-empty") 목표 기록 없음

                    div(class="chart-card")
                        div(class="chart-card-title") 종류별 통계
                        div(*ngIf="hasRunTypeStats", class="run-type-ratio-bar", aria-label="이번달 종류별 비율")
                            div(
                                *ngFor="let item of runTypeStats; trackBy: trackRunTypeSummary",
                                class="run-type-ratio-segment",
                                [ngClass]="'run-type-' + item.id",
                                [style.width.%]="item.countPercent",
                                [attr.title]="item.label + ' ' + item.countPercent + '%'")
                        div(*ngIf="hasRunTypeStats", class="run-type-summary-list")
                            div(*ngFor="let item of runTypeStats; trackBy: trackRunTypeSummary", class="run-type-summary-row", [class.empty]="!item.count")
                                div(class="run-type-row-head")
                                    span([ngClass]="runTypeClass(item.id)") {{item.label}}
                                    span(class="run-type-count") {{item.count}}회
                                div(class="run-type-bar-row")
                                    div(class="run-type-bar-track")
                                        div(class="run-type-bar-fill", [ngClass]="'run-type-' + item.id", [style.width.%]="item.distancePercent")
                                    div(class="run-type-distance") {{item.distanceText}}
                                div(class="run-type-statline")
                                    span 평균 {{item.averagePace}}{{paceUnitLabel}}
                                    span {{item.countPercent}}%
                    div(*ngIf="!hasRunTypeStats", class="empty-state chart-empty") 기록 없음

                    div(*ngIf="shouldShowCycleFeature && isCycleFeatureEnabled", class="chart-card cycle-pattern-card")
                        div(class="chart-card-title") 주기별 러닝 패턴
                        div(class="cycle-pattern-insight") {{cyclePatternInsightText}}
                        div(*ngIf="hasCyclePatternStats", class="cycle-pattern-list")
                            div(*ngFor="let item of cyclePatternStats; trackBy: trackCyclePattern", class="cycle-pattern-row", [ngClass]="'cycle-pattern-' + item.phase")
                                div(class="cycle-pattern-head")
                                    div(class="cycle-pattern-name") {{item.label}}
                                    div(class="cycle-pattern-count") {{item.runCount}}회
                                div(class="cycle-pattern-metrics")
                                    div
                                        span {{paceMetricLabel}}
                                        strong {{item.avgPace}}{{paceUnitLabel}}
                                    div
                                        span 평균 거리
                                        strong {{item.avgDistanceText}}
                                div(class="condition-row")
                                    span(*ngIf="!item.conditionItems.length", class="condition-empty") 직접 입력 없음
                                    span(*ngFor="let condition of item.conditionItems; trackBy: trackConditionItem", class="condition-chip")
                                        | {{condition.emoji}} {{condition.percent}}%
                        div(*ngIf="!hasCyclePatternStats", class="empty-state chart-empty") 주기와 러닝이 겹친 기록 없음

                    div(class="chart-card")
                        div(class="chart-card-title") 평균 심박수 / 케이던스
                        div(class="mini-stats")
                            div(*ngFor="let item of miniStats; trackBy: trackByLabel", class="mini-stat")
                                div(class="mini-stat-lbl") {{item.label}}
                                div(class="mini-stat-val")
                                    | {{item.value}}
                                    span {{item.unit}}

        div(class="screen-page", [class.active]="activeScreen === 'gallery'", id="screen-gallery")
            div(class="gallery-content")
                div(class="screen-heading gallery-heading")
                    div(class="section-title heading-title") 러닝 기록 갤러리
                    div(class="stat-label heading-sub") {{gallerySummaryText}}
                div(class="group-switcher", role="tablist", aria-label="기록 메뉴")
                    button(
                        *ngFor="let item of recordGroupItems; trackBy: trackById",
                        type="button",
                        class="group-switcher-btn",
                        role="tab",
                        [attr.data-screen]="item.id",
                        [class.active]="activeScreen === item.id",
                        [attr.aria-selected]="activeScreen === item.id",
                        (click)="setScreen(item.id)")
                        i(class="fa-solid", [ngClass]="item.icon", aria-hidden="true")
                        span {{item.label}}
                div(class="gallery-tab-row", role="tablist", aria-label="갤러리 필터")
                    button(
                        type="button",
                        class="gallery-tab-btn",
                        role="tab",
                        [class.active]="galleryTab === 'capture'",
                        [attr.aria-selected]="galleryTab === 'capture'",
                        (click)="setGalleryTab('capture')") 캡처
                    button(
                        type="button",
                        class="gallery-tab-btn",
                        role="tab",
                        [class.active]="galleryTab === 'media'",
                        [attr.aria-selected]="galleryTab === 'media'",
                        (click)="setGalleryTab('media')") 내 사진
                    button(
                        type="button",
                        class="gallery-tab-btn",
                        role="tab",
                        [class.active]="galleryTab === 'journal'",
                        [attr.aria-selected]="galleryTab === 'journal'",
                        (click)="setGalleryTab('journal')") 일기
                section(*ngIf="galleryTab === 'journal' ? !galleryJournalCount : !galleryItems.length", class="empty-state empty-state-panel gallery-empty-state")
                    i(class="fa-solid empty-state-icon", [ngClass]="galleryTab === 'journal' ? 'fa-book-open' : 'fa-images'", aria-hidden="true")
                    div(class="empty-state-title") {{galleryEmptyTitle}}
                    div(class="empty-state-description") {{galleryEmptyDescription}}
                div(*ngIf="galleryItems.length && galleryTab === 'capture'", class="gallery-list", role="list")
                    div(*ngFor="let item of galleryItems; trackBy: trackGallery", class="gallery-item", [class.more-item]="item.more", role="listitem", [attr.aria-label]="item.altText")
                        div(class="gallery-map-placeholder")
                            img(*ngIf="item.imageUrl", class="gallery-img", [src]="item.imageUrl", [attr.alt]="item.altText")
                            i(*ngIf="!item.more && !item.imageUrl", class="fa-solid fa-map", aria-hidden="true")
                            div(*ngIf="item.more", class="gallery-date") {{item.date}}
                        div(class="gallery-list-body")
                            div(class="gallery-list-head")
                                div(class="gallery-km") {{item.km}}
                                div(*ngIf="!item.more", class="gallery-head-meta")
                                    span([ngClass]="runTypeClass(item.runType)") {{runTypeLabel(item.runType)}}
                                    div(class="gallery-date") {{item.date}}
                            div(class="gallery-list-stats")
                                div(*ngFor="let stat of item.stats; trackBy: trackGalleryStat", class="gallery-list-stat")
                                    div(class="gallery-stat-value") {{stat.value}}
                                    div(class="gallery-stat-label") {{stat.label}}
                div(*ngIf="galleryItems.length && galleryTab === 'media'", class="gallery-media-grid", role="list")
                    button(
                        *ngFor="let item of galleryItems; trackBy: trackGallery",
                        type="button",
                        class="gallery-media-card",
                        [class.video-thumb]="item.mediaType === 'video'",
                        role="listitem",
                        [attr.aria-label]="item.altText",
                        (click)="item.media && openMediaViewer(item.media)")
                        img(*ngIf="item.mediaType === 'photo'", class="gallery-media-img", [src]="item.imageUrl", [attr.alt]="item.altText")
                        video(*ngIf="item.mediaType === 'video'", class="gallery-media-img", [src]="item.imageUrl", muted=true, playsinline=true, preload="metadata")
                        span(*ngIf="item.mediaType === 'video'", class="media-play-overlay gallery-play-overlay")
                            i(class="fa-solid fa-play", aria-hidden="true")
                        div(class="gallery-media-meta")
                            span {{item.date}}
                            span {{mediaTypeLabel(item.mediaType)}}
                section(*ngIf="galleryTab === 'journal' && galleryJournalCount", class="journal-calendar-panel")
                    div(class="cal-header journal-calendar-head")
                        div
                            div(class="cal-month") {{calendarTitle}}
                            div(class="journal-calendar-sub")
                                | {{activeMonthJournalCount ? activeMonthJournalCount + '개 일기' : '이 달엔 작성된 일기 없음'}}
                        div(class="cal-nav")
                            button(type="button", class="cal-nav-btn", aria-label="이전 달", (click)="changeCalendarMonth(-1)")
                                span(class="cal-nav-symbol", aria-hidden="true") &lt;
                            button(type="button", class="cal-nav-btn", aria-label="다음 달", (click)="changeCalendarMonth(1)")
                                span(class="cal-nav-symbol", aria-hidden="true") &gt;
                    div(class="journal-legend-row")
                        span(class="journal-legend-dot")
                        span 일기 작성일
                    div(
                        class="cal-grid journal-cal-grid",
                        (touchstart)="startCalendarSwipe($event)",
                        (touchend)="endCalendarSwipe($event)",
                        (touchcancel)="cancelCalendarSwipe()")
                        div(class="cal-day-label") 일
                        div(class="cal-day-label") 월
                        div(class="cal-day-label") 화
                        div(class="cal-day-label") 수
                        div(class="cal-day-label") 목
                        div(class="cal-day-label") 금
                        div(class="cal-day-label") 토
                        button(
                            *ngFor="let cell of journalCalendarCells; trackBy: trackCalendarCell",
                            type="button",
                            [class]="cell.className",
                            [class.selected]="cell.key === selectedJournalDate",
                            [disabled]="!cell.day",
                            [attr.aria-hidden]="!cell.day ? true : null",
                            [attr.aria-label]="cell.ariaLabel || null",
                            [attr.aria-pressed]="cell.day ? cell.key === selectedJournalDate : null",
                            (click)="selectJournalDate(cell)")
                            span(*ngIf="cell.day", class="cal-day-number") {{cell.day}}
                            span(*ngIf="cell.dotClass", [class]="cell.dotClass")
                            span(*ngIf="cell.journalCount > 1", class="journal-date-count") {{cell.journalCount}}
                    section(*ngIf="!activeMonthJournalCount", class="empty-state empty-state-panel journal-month-empty")
                        i(class="fa-solid fa-book-open empty-state-icon", aria-hidden="true")
                        div(class="empty-state-title") 이 달엔 작성된 일기가 없어
                    div(*ngIf="selectedJournalRuns.length", class="journal-selected-list", role="list")
                        div(class="journal-selected-title") {{selectedJournalDateText}}
                        button(
                            *ngFor="let run of selectedJournalRuns; trackBy: trackJournalRun",
                            type="button",
                            class="journal-selected-card",
                            role="listitem",
                            [attr.aria-label]="displayDate(run.date, true) + (run.journal_only ? ' 일기 보기' : ' 러닝 일기 보기')",
                            (click)="openJournalViewer(run)")
                            div(class="journal-selected-head")
                                div
                                    div(class="journal-gallery-date") {{run.journal_only ? '일기만 저장' : distanceText(run.distance_km, true)}}
                                    div(class="journal-gallery-distance") {{run.journal_only ? displayDate(run.date, false) : paceText(run.avg_pace)}}
                                span(*ngIf="!run.journal_only", [ngClass]="runTypeClass(run.run_type)") {{runTypeLabel(run.run_type)}}
                                span(*ngIf="run.journal_only", class="calendar-note-chip") 일기
                            div(class="journal-selected-text") {{run.journal}}
                            div(*ngIf="!run.journal_only", class="journal-gallery-stats")
                                span {{paceDisplaySettingsText}} {{paceText(run.avg_pace)}}
                                span 시간 {{shortDuration(run)}}
                                span 거리 {{distanceText(run.distance_km)}}
                            div(*ngIf="run.journal_only", class="journal-gallery-stats")
                                span {{displayDate(run.date, true)}}
                    section(*ngIf="selectedJournalDate && !selectedJournalRuns.length", class="empty-state empty-state-panel journal-selected-empty")
                        i(class="fa-solid fa-book-open empty-state-icon", aria-hidden="true")
                        div(class="empty-state-title") {{selectedJournalDateText}}에는 저장된 일기가 없어
                        div(class="empty-state-description") 기록 화면에서 이 날짜에 일기를 저장하면 여기에 표시돼.

        div(class="screen-page", [class.active]="activeScreen === 'chat'", id="screen-chat")
            div(class="chat-content")
                div(class="chat-header")
                    button(type="button", class="chat-history-btn", aria-label="대화 기록", (click)="openChatHistory()")
                        i(class="fa-solid fa-bars", aria-hidden="true")
                    div(class="chat-avatar", aria-hidden="true")
                        i(class="fa-solid fa-person-running", aria-hidden="true")
                    div(class="chat-identity")
                        div(class="chat-name") 페이서
                        div(class="chat-status") {{activeChatTitle}}
                    button(type="button", class="chat-settings-btn", data-ai-settings-open="true", aria-label="페이서 설정", (click)="openAiSettings()")
                        i(class="fa-solid fa-gear", aria-hidden="true")
                div(class="chat-quota-banner", [class.exhausted]="isAiUsageExhausted")
                    div(class="chat-quota-main")
                        div(class="chat-quota-icon")
                            i(class="fa-solid fa-gauge-high", aria-hidden="true")
                        div
                            div(class="chat-quota-title") 페이서 AI 이용 한도
                            div(class="chat-quota-body") {{aiUsageSummaryText}}
                    div(class="chat-quota-badge") {{aiUsageBadgeText}}
                div(*ngIf="isChatHistoryOpen", class="chat-history-backdrop", (click)="closeChatHistory()")
                aside(*ngIf="isChatHistoryOpen", class="chat-history-panel", role="dialog", aria-modal="true", aria-label="AI 대화 기록", (click)="$event.stopPropagation()")
                    div(class="chat-history-head")
                        div(class="chat-history-title") 대화 기록
                        button(type="button", class="chat-history-close", data-chat-history-close="true", aria-label="닫기", title="닫기", (click)="closeChatHistory()")
                            i(class="fa-solid fa-xmark", aria-hidden="true")
                    button(type="button", class="chat-new-btn", (click)="startNewChat()")
                        i(class="fa-solid fa-pen-to-square", aria-hidden="true")
                        span 새 대화
                    div(*ngIf="isChatHistoryLoading", class="chat-history-empty") 불러오는 중
                    div(*ngIf="!isChatHistoryLoading && !chatSessions.length", class="chat-history-empty") 저장된 대화가 없어
                    div(*ngIf="!isChatHistoryLoading && chatSessions.length", class="chat-history-list")
                        section(*ngFor="let group of chatHistoryGroups; trackBy: trackChatHistoryGroup", class="chat-history-group")
                            div(class="chat-history-date") {{group.label}}
                            div(
                                *ngFor="let session of group.sessions; trackBy: trackChatSession",
                                class="chat-history-row",
                                [class.active]="session.id === activeChatSessionId")
                                button(
                                    type="button",
                                    class="chat-history-item",
                                    [disabled]="deletingChatSessionId === session.id",
                                    (click)="selectChatSession(session)")
                                    div(class="chat-history-item-main")
                                        div(class="chat-history-item-title") {{session.title}}
                                        div(class="chat-history-item-preview") {{session.preview}}
                                    div(class="chat-history-item-time") {{formatChatSessionTime(session.updated_at)}}
                                button(
                                    type="button",
                                    class="chat-history-delete",
                                    aria-label="대화 삭제",
                                    title="대화 삭제",
                                    [disabled]="deletingChatSessionId === session.id",
                                    (click)="deleteChatSession(session, $event)")
                                    i(class="fa-solid fa-trash-can", aria-hidden="true")
                div(class="chat-messages")
                    div(*ngIf="shouldShowChatDayPrompt", class="chat-day-prompt")
                        div(class="chat-day-prompt-main")
                            div(class="chat-day-prompt-icon")
                                i(class="fa-solid fa-calendar-day", aria-hidden="true")
                            div
                                div(class="chat-day-prompt-title") 새로운 하루가 시작됐어
                                div(class="chat-day-prompt-body") {{chatDayPromptText}}
                        div(class="chat-day-prompt-actions")
                            button(type="button", class="chat-day-prompt-primary", (click)="startNewChat()")
                                i(class="fa-solid fa-pen-to-square", aria-hidden="true")
                                span 새 대화
                            button(type="button", class="chat-day-prompt-secondary", (click)="openChatHistory()")
                                i(class="fa-solid fa-clock-rotate-left", aria-hidden="true")
                                span 기록 보기
                    div(*ngFor="let message of chatMessages; trackBy: trackChat", class="msg", [class.msg-ai]="message.sender === 'ai'", [class.msg-user]="message.sender === 'user'", [class.msg-streaming]="message.streaming")
                        div(*ngIf="message.streaming && !message.text", class="pacer-thinking", role="status", aria-label="페이서가 답변을 준비 중")
                            span(class="pacer-thinking-icon", aria-hidden="true")
                                i(class="fa-solid fa-person-running")
                            span(class="pacer-thinking-track", aria-hidden="true")
                                span(class="pacer-thinking-step")
                                span(class="pacer-thinking-step")
                                span(class="pacer-thinking-step")
                        span(*ngIf="message.text", class="msg-text") {{message.text}}
                div(class="chat-input-row")
                    input(class="chat-input", type="text", [placeholder]="chatInputPlaceholder", [(ngModel)]="chatText", [disabled]="isChatInputDisabled", (keyup.enter)="sendChat()")
                    button(type="button", class="send-btn", aria-label="보내기", [disabled]="isChatInputDisabled || !chatText.trim()", (click)="sendChat()")
                        i(class="fa-solid fa-paper-plane", aria-hidden="true")

        div(class="screen-page", [class.active]="activeScreen === 'ai-settings'", id="screen-ai-settings")
            div(class="settings-content")
                div(class="settings-header")
                    button(type="button", class="settings-back-btn", data-ai-settings-back="true", aria-label="AI 채팅으로 돌아가기", (click)="setScreen('chat')")
                        i(class="fa-solid fa-chevron-left", aria-hidden="true")
                    div(class="settings-heading")
                        div(class="settings-title") 페이서 설정
                        div(class="settings-sub") {{pacerPersonaText}} 페르소나

                section(class="ai-settings-panel pacer-persona-panel")
                    div(class="ai-settings-label") 페르소나 선택
                    div(class="ai-settings-message") 러닝 기록을 해석하고 조언하는 말투를 고를 수 있어.
                    div(class="pacer-persona-list")
                        button(
                            *ngFor="let option of pacerPersonaOptions; trackBy: trackSettingsOption",
                            type="button",
                            class="pacer-persona-option",
                            [class.active]="pacerPersonaDraft === option.id",
                            (click)="selectPacerPersona(option.id)"
                        )
                            div(class="pacer-persona-option-main")
                                span(class="pacer-persona-option-title") {{option.label}}
                                span(class="pacer-persona-option-desc") {{option.description}}
                            i(*ngIf="pacerPersonaDraft === option.id", class="fa-solid fa-check", aria-hidden="true")

                section(class="ai-settings-panel pacer-persona-preview-panel")
                    div(class="ai-settings-top")
                        div
                            div(class="ai-settings-label") 대화 예시
                            div(class="ai-settings-provider") {{pacerPersonaDraftOption.label}}
                    div(class="ai-settings-message") {{pacerPersonaDraftOption.description}}
                    div(class="pacer-persona-preview")
                        div(
                            *ngFor="let example of pacerPersonaDraftExamples; trackBy: trackChat",
                            class="pacer-persona-example",
                            [class.ai]="example.sender === 'ai'",
                            [class.user]="example.sender === 'user'"
                        ) {{example.text}}

                button(type="button", class="pacer-persona-save-btn", [disabled]="!pacerPersonaHasChanges", (click)="savePacerPersona()")
                    i(class="fa-solid fa-floppy-disk", aria-hidden="true")
                    span {{pacerPersonaSaveText}}

        div(class="screen-page", [class.active]="activeScreen === 'profile'", id="screen-profile")
            div(class="profile-content")
                div(class="settings-header profile-header")
                    button(*ngIf="isProfileEditOpen", type="button", class="settings-back-btn", aria-label="설정으로 돌아가기", (click)="closeProfileEdit(); setScreen('settings')")
                        i(class="fa-solid fa-chevron-left", aria-hidden="true")
                    div(class="settings-heading")
                        div(class="settings-title") {{isProfileEditOpen ? '정보 수정' : '내 프로필'}}
                        div(class="settings-sub") {{isProfileEditOpen ? profileMetaText : myProfileDisplayIdText}}

                div(*ngIf="!isProfileEditOpen", class="group-switcher", role="tablist", aria-label="커뮤니티 메뉴")
                    button(
                        *ngFor="let item of communityGroupItems; trackBy: trackById",
                        type="button",
                        class="group-switcher-btn",
                        role="tab",
                        [attr.data-screen]="item.id",
                        [class.active]="activeScreen === item.id",
                        [attr.aria-selected]="activeScreen === item.id",
                        (click)="setScreen(item.id)")
                        i(class="fa-solid", [ngClass]="item.icon", aria-hidden="true")
                        span {{item.label}}

                section(*ngIf="!isProfileEditOpen", class="profile-hero")
                    div(class="profile-top")
                        div(class="profile-avatar-large")
                            img(*ngIf="profile?.profile_image", [src]="profile?.profile_image", [attr.alt]="profileNameText")
                            span(*ngIf="!profile?.profile_image") {{profileAvatarText}}
                        div(class="profile-stat-strip")
                            div(class="profile-stat")
                                strong {{myProfileRunCount}}
                                span 피드
                            button(type="button", class="profile-stat profile-stat-action", aria-label="팔로워 목록 보기", (click)="openProfileSocialPanel('followers')")
                                strong {{myProfileFollowerCount}}
                                span 팔로워
                            button(type="button", class="profile-stat profile-stat-action", aria-label="팔로잉 목록 보기", (click)="openProfileSocialPanel('following')")
                                strong {{myProfileFollowingCount}}
                                span 팔로잉
                    div(class="profile-name-row")
                        strong {{profileNameText}}
                        span {{profile?.is_public ? '공개 프로필' : '비공개 프로필'}}
                    div(class="profile-sub-row")
                        span 누적 {{myProfileDistanceText}}
                        span {{myProfileStartDateText}} 시작

                form(*ngIf="isProfileEditOpen", class="profile-edit-panel", [class.saving]="isProfileSaving", (submit)="saveProfileEdit(); $event.preventDefault()")
                    div(class="profile-edit-panel-head")
                        div
