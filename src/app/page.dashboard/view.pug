                            span(*ngFor="let badge of profileBadgeItems(user); trackBy: trackBadge", class="profile-social-badge")
                                i(class="fa-solid", [ngClass]="badgeIconClass(badge)", aria-hidden="true")
                                span {{badge.title}}
                        div(*ngIf="user.badges_public && !profileBadgeItems(user).length", class="profile-social-badge-empty") 아직 획득한 뱃지가 없어
                        div(*ngIf="!user.badges_public", class="profile-social-badge-empty") 비공개 프로필은 뱃지를 숨겨

                    div(*ngIf="user.stats_public && user.stats", class="friend-stat-grid")
