doctype html
html(lang="ko")
    head
        meta(charset="utf-8")
        title RunMate
        base(href="/")
        
        meta(name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover')
        meta(http-equiv='X-UA-Compatible' content='ie=edge')

        // pwa config
        meta(name='application-name' content='RunMate')
        meta(name='msapplication-TileColor' content='#12121c')
        meta(name='theme-color' content='#12121c')
        meta(name='apple-mobile-web-app-capable' content='yes')
        meta(name='apple-mobile-web-app-title' content='RunMate')
        meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
        meta(name='mobile-web-app-capable' content='yes')
        meta(name='HandheldFriendly' content='True')
        meta(name='MobileOptimized' content='320')
        meta(name='format-detection' content='telephone=no')
        link(rel="shortcut icon", href="/favicon.ico?v=rm-main-logo-20260620")

        link(rel="icon" type="image/png" sizes="192x192" href="/assets/brand/icon-192.png?v=rm-main-logo-20260620")
        link(rel="icon" type="image/png" sizes="512x512" href="/assets/brand/icon-512.png?v=rm-main-logo-20260620")
        link(rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=rm-main-logo-20260620")

        link(rel="icon" sizes="72x72" href="/favicon.ico?v=rm-main-logo-20260620")

        link(rel="manifest" href="/manifest.json")

        script(type="text/javascript").
            (function () {
                var darkBackground = "#12121c";
                var lightBackground = "#f7f7f9";
                var darkText = "#e8e8f0";
                var lightText = "#1a1a2e";
                var background = darkBackground;
                var text = darkText;

                try {
                    var rawSettings = window.localStorage && window.localStorage.getItem("runningmate-settings-v1");
                    var settings = rawSettings ? JSON.parse(rawSettings) : {};
                    var themeMode = settings && settings.themeMode;
                    var prefersLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;

                    if (themeMode === "light" || (themeMode === "system" && prefersLight)) {
                        background = lightBackground;
                        text = lightText;
                    }
                } catch (error) {}

                document.documentElement.style.setProperty("--app-shell-bg", background);
                document.documentElement.style.setProperty("--app-shell-text", text);
                document.documentElement.style.setProperty("--dashboard-screen-bg", background);
                document.documentElement.style.background = background;
                document.documentElement.style.backgroundColor = background;

                var themeMeta = document.querySelector("meta[name='theme-color']");
                if (themeMeta) {
                    themeMeta.setAttribute("content", background);
                }

                var tileMeta = document.querySelector("meta[name='msapplication-TileColor']");
                if (tileMeta) {
                    tileMeta.setAttribute("content", background);
                }
            })();

        style.
            html,
            body,
            app-root {
                width: 100%;
                height: 100%;
                min-height: 100%;
                height: -webkit-fill-available;
                min-height: -webkit-fill-available;
                margin: 0;
                background: var(--app-shell-bg, #12121c);
                background-color: var(--app-shell-bg, #12121c);
                color: var(--app-shell-text, #e8e8f0);
                overflow: hidden;
                display: block;
            }

            app-root {
                overflow: auto;
            }

            html.is-dashboard-page,
            html.is-dashboard-page body,
            body.is-dashboard-page,
            html.is-dashboard-page app-root,
            body.is-dashboard-page app-root {
                background: var(--dashboard-screen-bg, #12121c);
                background-color: var(--dashboard-screen-bg, #12121c);
            }

            @supports (height: 100dvh) {
                html,
                body,
                app-root {
                    height: 100dvh;
                    min-height: 100dvh;
                }
            }

            .app-shell-loader {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                box-sizing: border-box;
                width: 100%;
                min-height: 100vh;
                min-height: calc(100dvh + env(safe-area-inset-bottom, 0px));
                gap: 10px;
                padding: 24px 24px calc(24px + env(safe-area-inset-bottom, 0px));
                background: var(--app-shell-bg, #12121c);
                background-color: var(--app-shell-bg, #12121c);
                color: var(--app-shell-text, #e8e8f0);
                font-family: SUIT, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                text-align: center;
            }

            .app-shell-loader-mark {
                display: block;
                width: 92px;
                height: 92px;
                border-radius: 24px;
                background: #000000;
                object-fit: cover;
                box-shadow:
                    0 26px 54px rgba(0, 0, 0, 0.55),
                    0 0 44px rgba(36, 214, 181, 0.22);
            }

            .app-shell-loader-title {
                margin-top: 6px;
                color: var(--app-shell-text, #e8e8f0);
                font-size: clamp(28px, 7vw, 34px);
                font-weight: 900;
                line-height: 1.1;
            }

            .app-shell-recovery {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                box-sizing: border-box;
                width: 100%;
                min-height: 100vh;
                min-height: calc(100dvh + env(safe-area-inset-bottom, 0px));
                gap: 14px;
                padding: 28px 24px calc(28px + env(safe-area-inset-bottom, 0px));
                background: var(--app-shell-bg, #12121c);
                color: var(--app-shell-text, #e8e8f0);
                font-family: SUIT, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                text-align: center;
            }

            .app-shell-recovery-title {
                margin: 0;
                font-size: 22px;
                font-weight: 900;
                line-height: 1.25;
            }

            .app-shell-recovery-text {
                max-width: 280px;
                margin: 0;
                color: rgba(232, 232, 240, 0.72);
                font-size: 14px;
                font-weight: 700;
                line-height: 1.55;
            }

            .app-shell-recovery-actions {
                display: flex;
                width: min(100%, 320px);
                gap: 10px;
                margin-top: 6px;
            }

            .app-shell-recovery-action {
                flex: 1 1 0;
                min-height: 48px;
                border: 0;
                border-radius: 14px;
                background: #24d6b5;
                color: #020406;
                font: inherit;
                font-size: 14px;
                font-weight: 900;
            }

            .app-shell-recovery-action.secondary {
                background: rgba(255, 255, 255, 0.12);
                color: var(--app-shell-text, #e8e8f0);
            }

        script(type="text/javascript").
            (function () {
                var recovered = false;

                window.__RUNNINGMATE_APP_READY__ = false;
                window.addEventListener("runningmate:app-ready", function () {
                    window.__RUNNINGMATE_APP_READY__ = true;
                });

                function stillShowingShellLoader(root) {
                    return root && root.querySelector && root.querySelector(".app-shell-loader");
                }

                function recoverShell() {
                    if (window.__RUNNINGMATE_APP_READY__ || recovered) {
                        return;
                    }

                    var root = document.querySelector("app-root");
                    if (!stillShowingShellLoader(root)) {
                        return;
                    }

                    recovered = true;
                    root.innerHTML = [
                        '<div class="app-shell-recovery" role="alert">',
                        '<img class="app-shell-loader-mark" src="/assets/brand/running_logo_main_app.svg?v=rm-main-logo-20260620" alt="" aria-hidden="true">',
                        '<h1 class="app-shell-recovery-title">앱을 다시 열어주세요</h1>',
                        '<p class="app-shell-recovery-text">초기 화면을 불러오는 중 문제가 생겼습니다. 다시 시도하면 로그인 화면으로 이동합니다.</p>',
                        '<div class="app-shell-recovery-actions">',
                        '<button class="app-shell-recovery-action secondary" type="button" data-runningmate-reload>다시 열기</button>',
                        '<button class="app-shell-recovery-action" type="button" data-runningmate-access>로그인 화면</button>',
                        '</div>',
                        '</div>'
                    ].join("");

                    var reload = root.querySelector("[data-runningmate-reload]");
                    var access = root.querySelector("[data-runningmate-access]");
                    if (reload) {
                        reload.addEventListener("click", function () {
                            window.location.reload();
                        });
                    }
                    if (access) {
                        access.addEventListener("click", function () {
                            window.location.replace("/access");
                        });
                    }
                }

                window.addEventListener("error", function () {
                    window.setTimeout(recoverShell, 500);
                });
                window.addEventListener("unhandledrejection", function () {
                    window.setTimeout(recoverShell, 500);
                });
                window.setTimeout(recoverShell, 12000);
            })();

        script(type="text/javascript").
            if ("serviceWorker" in navigator) {
                const refreshVersion = "rm-watch-standalone-20260626";
                const refreshKey = `runningmate-sw-refresh-${refreshVersion}`;
                const hadController = Boolean(navigator.serviceWorker.controller);
                let refreshing = false;
                const refreshMarked = () => {
                    try {
                        return sessionStorage.getItem(refreshKey) === "1";
                    } catch (error) {
                        return refreshing;
                    }
                };
                const markRefreshed = () => {
                    try {
                        sessionStorage.setItem(refreshKey, "1");
                    } catch (error) {}
                };

                navigator.serviceWorker.addEventListener("controllerchange", () => {
                    if (!hadController || refreshing || refreshMarked()) {
                        return;
                    }
                    refreshing = true;
                    markRefreshed();
                    window.location.reload();
                });

                window.addEventListener("load", () => {
                    navigator.serviceWorker.register("/sw.js", {scope: "/", updateViaCache: "none"})
                        .then((registration) => {
                            registration.update().catch(() => {});

                            if (registration.waiting) {
                                registration.waiting.postMessage({type: "SKIP_WAITING"});
                            }

                            registration.addEventListener("updatefound", () => {
                                const worker = registration.installing;
                                if (!worker) {
                                    return;
                                }

                                worker.addEventListener("statechange", () => {
                                    if (worker.state === "installed" && navigator.serviceWorker.controller) {
                                        worker.postMessage({type: "SKIP_WAITING"});
                                    }
                                });
                            });
                        })
                        .catch(() => {});
                });
            }

    body
        app-root
            div(class="app-shell-loader", role="status", aria-live="polite")
                img(class="app-shell-loader-mark", src="/assets/brand/running_logo_main_app.svg?v=rm-main-logo-20260620", alt="", aria-hidden="true")
                div(class="app-shell-loader-title") RunMate
