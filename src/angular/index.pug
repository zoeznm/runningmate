doctype html
html(lang="ko")
    head
        meta(charset="utf-8")
        title RunMate
        base(href="/")
        
        meta(name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover')
        meta(http-equiv='X-UA-Compatible' content='ie=edge')

        // pwa config
        meta(name='application-name' content='RunMate')
        meta(name='msapplication-TileColor' content='#000000')
        meta(name='theme-color' content='#000000')
        meta(name='apple-mobile-web-app-capable' content='yes')
        meta(name='apple-mobile-web-app-title' content='RunMate')
        meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
        meta(name='mobile-web-app-capable' content='yes')
        meta(name='HandheldFriendly' content='True')
        meta(name='MobileOptimized' content='320')
        meta(name='format-detection' content='telephone=no')
        link(rel="shortcut icon", href="/favicon.ico?v=rm-main-logo-20260620")

        link(rel="icon" type="image/png" sizes="192x192" href="/assets/brand/icon-192.png?v=rm-main-logo-20260620")
        link(rel="icon" type="image/png" sizes="512x512" href="/assets/brand/icon-512.png?v=rm-main-logo-20260620")
        link(rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png?v=rm-main-logo-20260620")

        link(rel="icon" sizes="72x72" href="/favicon.ico?v=rm-main-logo-20260620")

        link(rel="manifest" href="/manifest.json")

        script(type="text/javascript").
            (function () {
                var background = "#000000";
                var text = "#ffffff";
                document.documentElement.style.setProperty("--app-shell-bg", background);
                document.documentElement.style.setProperty("--app-shell-text", text);
                document.documentElement.style.background = background;

                var themeMeta = document.querySelector("meta[name='theme-color']");
                if (themeMeta) {
                    themeMeta.setAttribute("content", background);
                }
            })();

        style.
            html,
            body,
            app-root {
                width: 100%;
                height: 100%;
                min-height: 100%;
                margin: 0;
                background: var(--app-shell-bg, #000000);
                color: var(--app-shell-text, #ffffff);
                overflow: hidden;
                display: block;
            }

            app-root {
                overflow: auto;
            }

            html.is-dashboard-page,
            html.is-dashboard-page body,
            body.is-dashboard-page,
            html.is-dashboard-page app-root,
            body.is-dashboard-page app-root {
                background: var(--dashboard-screen-bg, #12121c);
            }

            @supports (height: 100dvh) {
                html,
                body,
                app-root {
                    height: 100dvh;
                    min-height: 100dvh;
                }
            }

            .app-shell-loader {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                width: 100%;
                min-height: 100vh;
                min-height: 100dvh;
                gap: 10px;
                padding: 24px;
                background: var(--app-shell-bg, #000000);
                color: var(--app-shell-text, #ffffff);
                font-family: SUIT, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                text-align: center;
            }

            .app-shell-loader-mark {
                display: block;
                width: 92px;
                height: 92px;
                border-radius: 24px;
                background: #000000;
                object-fit: cover;
                box-shadow:
                    0 26px 54px rgba(0, 0, 0, 0.55),
                    0 0 44px rgba(36, 214, 181, 0.22);
            }

            .app-shell-loader-title {
                margin-top: 6px;
                color: #ffffff;
                font-size: clamp(28px, 7vw, 34px);
                font-weight: 900;
                line-height: 1.1;
            }

        script(type="text/javascript").
            if ("serviceWorker" in navigator) {
                const refreshVersion = "rm-access-landscape-emerald-20260621";
                const refreshKey = `runningmate-sw-refresh-${refreshVersion}`;
                const hadController = Boolean(navigator.serviceWorker.controller);
                let refreshing = false;
                const refreshMarked = () => {
                    try {
                        return sessionStorage.getItem(refreshKey) === "1";
                    } catch (error) {
                        return refreshing;
                    }
                };
                const markRefreshed = () => {
                    try {
                        sessionStorage.setItem(refreshKey, "1");
                    } catch (error) {}
                };

                navigator.serviceWorker.addEventListener("controllerchange", () => {
                    if (!hadController || refreshing || refreshMarked()) {
                        return;
                    }
                    refreshing = true;
                    markRefreshed();
                    window.location.reload();
                });

                window.addEventListener("load", () => {
                    navigator.serviceWorker.register("/sw.js", {scope: "/", updateViaCache: "none"})
                        .then((registration) => {
                            registration.update().catch(() => {});

                            if (registration.waiting) {
                                registration.waiting.postMessage({type: "SKIP_WAITING"});
                            }

                            registration.addEventListener("updatefound", () => {
                                const worker = registration.installing;
                                if (!worker) {
                                    return;
                                }

                                worker.addEventListener("statechange", () => {
                                    if (worker.state === "installed" && navigator.serviceWorker.controller) {
                                        worker.postMessage({type: "SKIP_WAITING"});
                                    }
                                });
                            });
                        })
                        .catch(() => {});
                });
            }

    body
        app-root
            div(class="app-shell-loader", role="status", aria-live="polite")
                img(class="app-shell-loader-mark", src="/assets/brand/running_logo_main_app.svg?v=rm-main-logo-20260620", alt="", aria-hidden="true")
                div(class="app-shell-loader-title") RunMate
