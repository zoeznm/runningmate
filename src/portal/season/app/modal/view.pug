div(class="wiz-app-modal", *ngIf="model.isshow")
    div(class="wiz-app-modal-scrim")
    div(class="wiz-app-modal-frame")
        div(class="wiz-app-modal-position")
            section(class="wiz-app-modal-dialog", role="dialog", aria-modal="true")
                div(class="wiz-app-modal-content")
                    div(
                        class="wiz-app-modal-icon",
                        [ngClass]="statusIconWrapClass()")
                        
                        svg(*ngIf="model.opts.status == 'error'", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor", aria-hidden="true")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M12 9v3.75m0 3.75h.008v.008H12V16.5Zm8.25 2.25h-16.5L12 3.75l8.25 15Z")
                        
                        svg(*ngIf="model.opts.status == 'warning'", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor", aria-hidden="true")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M12 9v3.75m0 3.75h.008v.008H12V16.5Zm8.25 2.25h-16.5L12 3.75l8.25 15Z")
                        
                        svg(*ngIf="model.opts.status == 'success'", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor", aria-hidden="true")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z")

                    div(class="wiz-app-modal-copy")
                        h3(*ngIf="model.opts.title") {{model.opts.title}}
                        p {{model.opts.message}}
                
                div(
                    class="wiz-app-modal-actions",
                    [class.wiz-app-modal-actions-single]="!model.opts.cancel || !model.opts.action")
                    button(
                        (click)="model.hide()", 
                        type="button", 
                        *ngIf="model.opts.cancel",
                        [class]="cancelButtonClass()") {{model.opts.cancel}}
                    button(
                        [class]="btnColorClass()",
                        *ngIf="model.opts.action",
                        (click)="model.action()") {{model.opts.action}}
