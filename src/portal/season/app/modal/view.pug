div(class="relative z-50", *ngIf="model.isshow")
    div(class="fixed inset-0 bg-[#070b14] bg-opacity-75 backdrop-blur-sm transition-opacity")
    div(class="fixed inset-0 z-50 w-screen overflow-y-auto px-4 py-6")
        div(class="flex min-h-full items-center justify-center text-center")
            section(class="relative w-full max-w-[390px] overflow-hidden rounded-lg border border-white/10 bg-[#111827] p-5 text-left shadow-2xl shadow-black/30 transition-all", role="dialog", aria-modal="true")
                div(class="flex items-start gap-3")
                    div(
                        class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg border",
                        [ngClass]="statusIconWrapClass()")
                        
                        svg(*ngIf="model.opts.status == 'error'", class="h-5 w-5", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor", aria-hidden="true")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M12 9v3.75m0 3.75h.008v.008H12V16.5Zm8.25 2.25h-16.5L12 3.75l8.25 15Z")
                        
                        svg(*ngIf="model.opts.status == 'warning'", class="h-5 w-5", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor", aria-hidden="true")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M12 9v3.75m0 3.75h.008v.008H12V16.5Zm8.25 2.25h-16.5L12 3.75l8.25 15Z")
                        
                        svg(*ngIf="model.opts.status == 'success'", class="h-5 w-5", fill="none", viewBox="0 0 24 24", stroke-width="1.8", stroke="currentColor", aria-hidden="true")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z")

                    div(class="min-w-0 flex-1")
                        h3(*ngIf="model.opts.title", class="text-[15px] font-black leading-6 text-white") {{model.opts.title}}
                        p(class="whitespace-break-spaces text-[13px] font-semibold leading-6 text-slate-300") {{model.opts.message}}
                
                div(class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end")
                    button(
                        (click)="model.hide()", 
                        type="button", 
                        *ngIf="model.opts.cancel",
                        [class]="cancelButtonClass()") {{model.opts.cancel}}
                    button(
                        [class]="btnColorClass()",
                        *ngIf="model.opts.action",
                        (click)="model.action()") {{model.opts.action}}
