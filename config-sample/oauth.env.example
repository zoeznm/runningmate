# Copy to /opt/app/config/oauth.env on the server and fill the real client values.
NAVER_CLIENT_ID=<naver_client_id>
NAVER_CLIENT_SECRET=<naver_client_secret>
NAVER_REDIRECT_URI=https://run.myrunningmate.com/access

GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
GOOGLE_REDIRECT_URI=https://run.myrunningmate.com/api/auth/oauth/google/callback
