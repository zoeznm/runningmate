# Recommended: SendGrid with authenticated domain DNS.
# SendGrid sends mail; it does not create an inbox.
# Create an inbox/alias at your mail host only if replies must be received.
RUNNINGMATE_MAIL_DOMAIN=myrunningmate.com
RUNNINGMATE_MAIL_FROM=no-reply@myrunningmate.com
RUNNINGMATE_MAIL_FROM_NAME=RunningMate
SENDGRID_API_KEY=<sendgrid_api_key>

# Alternative: SMTP provider account.
# RUNNINGMATE_MAIL_DOMAIN=myrunningmate.com
# RUNNINGMATE_MAIL_FROM=no-reply@myrunningmate.com
# RUNNINGMATE_MAIL_FROM_NAME=RunningMate
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=no-reply@myrunningmate.com
# SMTP_PASSWORD=<smtp_password_or_app_password>
# SMTP_USE_TLS=true
